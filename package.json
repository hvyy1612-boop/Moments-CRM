{
  "name": "moments-cms",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "set-password": "tsx scripts/set-password.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "show-logs": "tsx scripts/show-logs.ts",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "assert:test-db": "node scripts/assert-test-db.mjs",
    "test:db:migrate": "node scripts/test-db-migrate.mjs",
    "e2e": "playwright test",
    "audit:high": "npm audit --audit-level=high",
    "check:routes": "node scripts/audit-routes.mjs",
    "check:passwordhash": "node scripts/check-passwordhash.mjs",
    "check:tokens": "node scripts/check-design-tokens.mjs",
    "check:money": "node scripts/check-money-number.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run check:routes && npm run check:passwordhash && npm run check:tokens && npm run check:money && npm run e2e && npm run audit:high"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "~6.12.0",
    "@react-pdf/renderer": "^4.9.0",
    "google-auth-library": "^11.0.2",
    "next": "^15.1.0",
    "nodemailer": "^6.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.0",
    "prisma": "~6.12.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^4.1.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "sharp": "^0.35.3"
  }
}
