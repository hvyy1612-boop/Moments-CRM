// Moments — Prisma schema. Project-centric (Database Blueprint v2 final).
// Company, auth (User/Session/PasswordReset/SignInLog), Client, Enquiry (lead), Project (job),
// Quote/QuoteVersion/QuoteLine, Contract/ContractVersion, Invoice/InvoiceLine/InvoiceInstalment/
// CreditNote/Payment/PaymentTransaction/Refund, WorkItem (tasks), Communication, CalendarEvent,
// ChangeRequest, ProjectRequirement, ProjectTeamMember, notifications, AuditLog.
// Only what the running app uses (unused models and values removed 2026-10-06).
//
// Naming: code = camelCase field + PascalCase model; database = snake_case column + snake_case
// plural table (via @map / @@map). Types are explicit per column (varchar(n) with a sensible
// bound, citext for email, text for free-form notes). See docs/17-data-dictionary.md.
//
// Locked decisions: single-tenant (one Company row; company_id là reserved field, không RLS),
// enquiry (lead) có bảng riêng `enquiries` → convert ra Client + Project (B2), work_items canonical,
// CUID id (varchar 30), money Decimal, timestamptz. Con số business = TBD (không hard-code).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [citext]
}

// ---------- Enums ----------

// ADMIN = owner (everything); STUDIO = staff (day-to-day CRM work); SUPERVISOR = read-only reviewer
// (sees the CRM pages, every write is refused, no Activity / Settings / Users).
enum UserRole {
  ADMIN
  STUDIO
  SUPERVISOR
}

enum SecurityOutcome {
  SUCCESS
  FAILURE
}

enum ClientType {
  INDIVIDUAL
  BUSINESS
}

enum ClientStatus {
  PROSPECT
  ACTIVE
  ARCHIVED
}

// Operational lifecycle of a Job/Project (macro axis; the WorkItem board is the micro axis).
// BOOKING_REQUESTED = provisional (from the lead, awaiting the deposit); CONFIRMED = deposit paid (or
// contract signed); COMPLETED = every task done and fully settled; CLOSED = closed by staff. The sales
// funnel lives on Enquiry (the lead), never here.
enum ProjectLifecycle {
  BOOKING_REQUESTED
  CONFIRMED
  COMPLETED
  CLOSED
  CANCELLED
}

// Derived dimension. Slice 1 dùng lifecycle + commercial; các chiều khác thêm ở slice sau.
enum CommercialStatus {
  UNQUOTED
  QUOTED
  ACCEPTED
  DEPOSIT_PAID
  PAID
  CANCELLED
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  SUPERSEDED
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
}

// How a job task's base due date is derived (docs/25 Part 2). No MANUAL anchor: a manual date is
// WorkItem.dueOverrideAt (Rule D1).
enum DueAnchor {
  SHOOT
  JOB_CONFIRMED
  FIXED
}

enum InvoiceType {
  DEPOSIT
  BALANCE
  SUPPLEMENTARY
}

enum InvoiceStatus {
  ISSUED
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum PaymentStatus {
  PAID
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD
  CASH
  OTHER
}

enum TransactionType {
  CHARGE
  REFUND
}

// B2: acquisition layer — lead (Enquiry) tách khỏi Client. Xem docs/18-crm-flow-reference.md.
enum EnquiryStatus {
  NEW_ENQUIRY
  CONTACTED
  CONSULTATION
  QUOTE_SENT
  AWAITING_BOOKING_CONFIRMATION
  BOOKING_CONFIRMED
  DECLINED
}

// A work item is one concrete thing a staff member must do on a case (contract docs/23 §6). It is the
// single task concept - no separate Task/WorkflowTask model.
enum WorkItemStatus {
  PENDING
  COMPLETED
  CANCELLED
}

// Where a lead came from: the website form, or staff adding it (Add lead / Add client / Add job).
// How the client heard about the studio is the free-text `heardAbout`, not this field.
enum EnquirySource {
  WEBSITE
  MANUAL
}

enum ClientSource {
  ENQUIRY
  REFERRAL
  MANUAL
  OTHER
}

enum CommunicationType {
  NOTE
  CLIENT_MESSAGE
}

enum ChangeRequestType {
  COMMERCIAL
  OPERATIONAL
  CLIENT_DATA
  PRODUCTION
}

enum ChangeRequestStatus {
  PENDING
  IMPACT_ASSESSMENT
  APPROVED
  REJECTED
  APPLIED
}

// ---------- Company (single tenant) ----------

model Company {
  id        String   @id @default(cuid()) @db.VarChar(30)
  name      String   @db.VarChar(150)
  abn       String?  @db.VarChar(20) // OQ-007 placeholder cho tới khi xác nhận
  currency  String   @default("AUD") @db.VarChar(3)
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  users          User[]
  clients        Client[]
  projects       Project[]
  enquiries      Enquiry[]
  packages       Package[]
  workItems      WorkItem[]
  calendarEvents CalendarEvent[]
  numberCounters NumberCounter[]

  @@map("companies")
}

/// Per-(company × record type × year) running counter for human record numbers (C/E/Q/J/INV + YYYY +
/// 4 digits). Incremented atomically inside a transaction by src/lib/domain/numbering.ts — never COUNT+1.
enum RecordNumberType {
  CLIENT
  ENQUIRY
  QUOTE
  JOB
  INVOICE
}

model NumberCounter {
  companyId String           @map("company_id") @db.VarChar(30)
  type      RecordNumberType
  year      Int
  value     Int              @default(0)
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, type, year])
  @@map("number_counter")
}

// ---------- Identity / auth (giữ nguyên hình dạng để code auth tái dùng) ----------

model User {
  id                        String    @id @default(cuid()) @db.VarChar(30)
  companyId                 String    @map("company_id") @db.VarChar(30)
  email                     String    @unique @db.Citext
  passwordHash              String    @map("password_hash") @db.VarChar(255)
  passwordAlgo              String    @map("password_algo") @db.VarChar(30)
  role                      UserRole
  name                      String    @db.VarChar(150)
  isActive                  Boolean   @default(true) @map("is_active")
  status                    String    @default("ACTIVE") @db.VarChar(20) // ACTIVE | DELETED (Remove on the Users page = soft delete)
  mustChangePassword        Boolean   @default(false) @map("must_change_password")
  lastLoginAt               DateTime? @map("last_login_at") @db.Timestamptz
  failedAttempts            Int       @default(0) @map("failed_attempts")
  lockedUntil               DateTime? @map("locked_until") @db.Timestamptz
  // Step-up PIN for the Activity page: a 4-digit PIN (hashed, Argon2id) an admin sets to re-open the
  // read-only security page, with its own lockout counter. Password stays as a fallback. All nullable.
  activityPinHash           String?   @map("activity_pin_hash") @db.VarChar(255)
  activityPinAlgo           String?   @map("activity_pin_algo") @db.VarChar(30)
  activityPinFailedAttempts Int       @default(0) @map("activity_pin_failed_attempts")
  activityPinLockedUntil    DateTime? @map("activity_pin_locked_until") @db.Timestamptz
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company                 Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  passwordResets          PasswordReset[]
  sessions                Session[]
  signInLogs              SignInLog[]
  recoveryCodes           RecoveryCode[]
  auditLogs               AuditLog[]
  ownedProjects           Project[]         @relation("ProjectOwner")
  createdQuoteVersions    QuoteVersion[]    @relation("QuoteVersionCreatedBy")
  createdContractVersions ContractVersion[] @relation("ContractVersionCreatedBy")
  recordedPayments        Payment[]         @relation("PaymentRecordedBy")
  ownedEnquiries          Enquiry[]         @relation("EnquiryOwner")
  communications          Communication[]   @relation("CommunicationBy")
  editedCommunications    Communication[]   @relation("CommunicationEditedBy")
  requestedChanges        ChangeRequest[]   @relation("ChangeRequestedBy")
  approvedChanges         ChangeRequest[]   @relation("ChangeApprovedBy")
  completedWorkItems      WorkItem[]        @relation("WorkItemCompletedBy")
  createdCalendarEvents   CalendarEvent[]   @relation("CalendarEventCreatedBy")

  @@index([companyId])
  @@index([role])
  @@map("users")
}

model PasswordReset {
  id          String    @id @default(cuid()) @db.VarChar(30)
  userId      String    @map("user_id") @db.VarChar(30)
  tokenHash   String    @map("token_hash") @db.VarChar(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  usedAt      DateTime? @map("used_at") @db.Timestamptz
  requestedIp String    @map("requested_ip") @db.VarChar(45)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_resets")
}

/// One-time password recovery code. A staff login ID is not a mailbox, so a forgotten password is reset
/// with one of these instead of an email link: six are issued when the staff member sets their own
/// password (shown once, downloadable), only the Argon2id hash is stored, and a used code is deleted.
model RecoveryCode {
  id        String   @id @default(cuid()) @db.VarChar(30)
  userId    String   @map("user_id") @db.VarChar(30)
  codeHash  String   @map("code_hash") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

model Session {
  id                String    @id @default(cuid()) @db.VarChar(30)
  userId            String    @map("user_id") @db.VarChar(30)
  tokenHash         String    @map("token_hash") @db.VarChar(64)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz
  lastActiveAt      DateTime  @default(now()) @map("last_active_at") @db.Timestamptz
  userAgent         String?   @map("user_agent") @db.VarChar(400)
  ipAddress         String?   @map("ip_address") @db.VarChar(45)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("sessions")
}

model SignInLog {
  id             String          @id @default(cuid()) @db.VarChar(30)
  eventType      String          @map("event_type") @db.VarChar(100)
  userId         String?         @map("user_id") @db.VarChar(30)
  emailAttempted String?         @map("email_attempted") @db.Citext
  ipAddress      String          @map("ip_address") @db.VarChar(45)
  userAgent      String?         @map("user_agent") @db.VarChar(400)
  outcome        SecurityOutcome
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  // INSERT-ONLY (trigger trong migration).

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
  @@map("security_events")
}

// ---------- CRM ----------

model Client {
  id               String       @id @default(cuid()) @db.VarChar(30)
  companyId        String       @map("company_id") @db.VarChar(30)
  clientNumber     String?      @map("client_number") @db.VarChar(20) // human id C<YYYY><4d>, unique per company
  type             ClientType   @default(INDIVIDUAL)
  status           ClientStatus @default(PROSPECT)
  source           ClientSource @default(MANUAL) // B2: khách đến từ đâu (dashboard)
  displayName      String       @map("display_name") @db.VarChar(150)
  legalName        String?      @map("legal_name") @db.VarChar(150)
  firstName        String?      @map("first_name") @db.VarChar(80)
  lastName         String?      @map("last_name") @db.VarChar(80)
  email            String       @unique @db.Citext // dedupe tại enquiry (P1)
  phone            String?      @db.VarChar(30)
  street           String?      @db.VarChar(200)
  suburb           String?      @db.VarChar(100)
  state            String?      @db.VarChar(100)
  postcode         String?      @db.VarChar(20)
  country          String?      @db.VarChar(100)
  partnerName      String?      @map("partner_name") @db.VarChar(150) // e.g. wedding partner, shown on the job Overview
  preferredContact String?      @map("preferred_contact") @db.VarChar(120) // how the client prefers to be reached
  instagram        String?      @db.VarChar(100) // handle without the @
  notes            String?      @db.Text // ghi chú tự do, không giới hạn
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt       DateTime?    @map("archived_at") @db.Timestamptz

  company                Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  projects               Project[]
  convertedFromEnquiries Enquiry[]       @relation("EnquiryConvertedClient")
  enquiries              Enquiry[]       @relation("ClientEnquiries")
  communications         Communication[]
  calendarEvents         CalendarEvent[]

  @@unique([companyId, clientNumber])
  @@index([companyId])
  @@index([status])
  @@map("clients")
}

// ---------- Project (operational case, bắt đầu từ enquiry) ----------

model Project {
  id                  String           @id @default(cuid()) @db.VarChar(30)
  companyId           String           @map("company_id") @db.VarChar(30)
  clientId            String           @map("client_id") @db.VarChar(30)
  code                String           @unique @db.VarChar(30)
  name                String           @db.VarChar(200)
  ownerUserId         String?          @map("owner_user_id") @db.VarChar(30)
  lifecycleStatus     ProjectLifecycle @default(BOOKING_REQUESTED) @map("lifecycle_status")
  commercialStatus    CommercialStatus @default(UNQUOTED) @map("commercial_status") // derived
  source              String?          @db.VarChar(50) // nguồn enquiry (I-6 taxonomy, TBD)
  confirmedByClientAt DateTime?        @map("confirmed_by_client_at") @db.Timestamptz // when the booking was confirmed (deposit paid / contract signed): anchors JOB_CONFIRMED tasks
  enquiryReceivedAt   DateTime         @default(now()) @map("enquiry_received_at") @db.Timestamptz
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company                Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  client                 Client               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  owner                  User?                @relation("ProjectOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  quotes                 Quote[]              @relation("ProjectQuotes")
  contracts              Contract[]
  workItems              WorkItem[]
  invoices               Invoice[]
  payments               Payment[]
  convertedFromEnquiries Enquiry[]            @relation("EnquiryConvertedProject")
  communications         Communication[]
  changeRequests         ChangeRequest[]
  requirements           ProjectRequirement[]
  teamMembers            ProjectTeamMember[]

  @@index([companyId])
  @@index([clientId])
  @@index([lifecycleStatus])
  @@index([enquiryReceivedAt])
  @@map("projects")
}

// ---------- Commercial: Package (F-PKG, B2) ----------
// Gói dịch vụ giá cố định (GST-inclusive), dùng làm dòng có sẵn khi soạn quote / hoá đơn. Đổi giá gói
// sau KHÔNG đổi record cũ (giá đã copy vào dòng quote / hoá đơn).
model Package {
  id               String   @id @default(cuid()) @db.VarChar(30)
  companyId        String   @map("company_id") @db.VarChar(30)
  name             String   @db.VarChar(150)
  description      String?  @db.Text
  inclusions       String?  @db.Text // mỗi dòng 1 mục
  basePriceInclGst Decimal  @default(0) @map("base_price_incl_gst") @db.Decimal(12, 2)
  isAddOn          Boolean  @default(false) @map("is_add_on") // add-on (film, super 8, album) vs base package
  active           Boolean  @default(true)
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, active])
  @@map("packages")
}

// ---------- Acquisition: Enquiry = "Lead" in the UI (like Project = "Job") ----------
// A potential booking from first enquiry to a paid deposit. Convert (its quote accepted, or Add job) upserts
// the Client by email + creates a provisional Job and links it (convertedProjectId); the lead then moves
// AWAITING_BOOKING_CONFIRMATION -> BOOKING_CONFIRMED on the deposit. Never deleted: DECLINED is kept and
// can be reopened. Email is NOT unique (one person can enquire several times). See docs/GLOSSARY.md.
model Enquiry {
  id                   String        @id @default(cuid()) @db.VarChar(30)
  companyId            String        @map("company_id") @db.VarChar(30)
  enquiryNumber        String?       @map("enquiry_number") @db.VarChar(20) // human id L<YYYY><4d>, unique per company
  ownerUserId          String?       @map("owner_user_id") @db.VarChar(30)
  name                 String        @db.VarChar(150)
  firstName            String?       @map("first_name") @db.VarChar(80)
  lastName             String?       @map("last_name") @db.VarChar(80)
  email                String        @db.Citext // KHÔNG unique: một người có thể hỏi nhiều lần
  phone                String?       @db.VarChar(30)
  street               String?       @db.VarChar(200)
  suburb               String?       @db.VarChar(100)
  state                String?       @db.VarChar(100)
  postcode             String?       @db.VarChar(20)
  country              String?       @db.VarChar(100)
  isCompany            Boolean       @default(false) @map("is_company")
  eventType            String?       @map("event_type") @db.VarChar(50)
  eventDate            DateTime?     @map("event_date") @db.Date // chỉ ngày, chưa có giờ
  message              String?       @db.Text
  // Wedding-enquiry detail fields (parity with the public website enquiry form). All optional.
  partnerName          String?       @map("partner_name") @db.VarChar(150)
  coverage             String?       @db.VarChar(30) // Photography / Videography / Both
  gettingReadyLocation String?       @map("getting_ready_location") @db.Text
  ceremonyLocation     String?       @map("ceremony_location") @db.Text
  weddingDetails       String?       @map("wedding_details") @db.Text
  styleReason          String?       @map("style_reason") @db.Text
  heardAbout           String?       @map("heard_about") @db.Text
  source               EnquirySource @default(WEBSITE)
  status               EnquiryStatus @default(NEW_ENQUIRY)
  clientId             String?       @map("client_id") @db.VarChar(30) // the client this lead is about (SN "Primary Client Contact")
  convertedClientId    String?       @map("converted_client_id") @db.VarChar(30)
  convertedProjectId   String?       @unique @map("converted_project_id") @db.VarChar(30) // one lead per job
  viewedAt             DateTime?     @map("viewed_at") @db.Timestamptz // Gmail-style read state: null = new/unread until a staff opens the detail
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company          Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  owner            User?           @relation("EnquiryOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  client           Client?         @relation("ClientEnquiries", fields: [clientId], references: [id], onDelete: SetNull)
  convertedClient  Client?         @relation("EnquiryConvertedClient", fields: [convertedClientId], references: [id], onDelete: SetNull)
  convertedProject Project?        @relation("EnquiryConvertedProject", fields: [convertedProjectId], references: [id], onDelete: SetNull)
  quotes           Quote[]         @relation("EnquiryQuotes")
  communications   Communication[]
  workItems        WorkItem[]

  @@unique([companyId, enquiryNumber])
  @@index([companyId])
  @@index([status])
  @@index([email])
  @@index([clientId])
  @@map("enquiries")
}

// ---------- Commercial: Quote ----------

model Quote {
  id               String      @id @default(cuid()) @db.VarChar(30)
  // docs/31: a quote belongs to an ENQUIRY (canonical). projectId is LEGACY/compat (set on accept) and
  // therefore nullable now. seq = per-company sequential number for the display id (Q-0001).
  enquiryId        String?     @map("enquiry_id") @db.VarChar(30)
  projectId        String?     @map("project_id") @db.VarChar(30)
  seq              Int?        @unique // per-company display number; quote creation retries on a clash
  reference        String?     @db.VarChar(60) // editable, required Quote ID shown to the client (defaults to Q-seq)
  viewToken        String      @unique @map("view_token") @db.VarChar(64) // client xem quote qua link
  status           QuoteStatus @default(DRAFT) // cache của current version
  currentVersionId String?     @unique @map("current_version_id") @db.VarChar(30)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  enquiry        Enquiry?       @relation("EnquiryQuotes", fields: [enquiryId], references: [id], onDelete: SetNull)
  project        Project?       @relation("ProjectQuotes", fields: [projectId], references: [id], onDelete: Restrict)
  currentVersion QuoteVersion?  @relation("QuoteCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       QuoteVersion[] @relation("QuoteVersions")

  @@index([projectId])
  @@index([enquiryId])
  @@map("quotes")
}

model QuoteVersion {
  id                 String      @id @default(cuid()) @db.VarChar(30)
  quoteId            String      @map("quote_id") @db.VarChar(30)
  versionNumber      Int         @map("version_number")
  status             QuoteStatus @default(DRAFT)
  currency           String      @default("AUD") @db.VarChar(3)
  subtotal           Decimal     @default(0) @db.Decimal(12, 2)
  discountTotal      Decimal     @default(0) @map("discount_total") @db.Decimal(12, 2)
  taxTotal           Decimal     @default(0) @map("tax_total") @db.Decimal(12, 2)
  total              Decimal     @default(0) @db.Decimal(12, 2)
  // Presentation fields (docs/31): an optional client PO reference and free-form notes; never affect totals.
  poNumber           String?     @map("po_number") @db.VarChar(60)
  notes              String?     @db.Text
  depositPercent     Int?        @map("deposit_percent") // docs/31: booking deposit %; balance = 100 - this
  issueDate          DateTime?   @map("issue_date") @db.Timestamptz // required in the editor; the date the quote is issued
  validUntil         DateTime?   @map("valid_until") @db.Timestamptz
  createdByUserId    String?     @map("created_by_user_id") @db.VarChar(30)
  sentToClientAt     DateTime?   @map("sent_to_client_at") @db.Timestamptz
  acceptedByClientAt DateTime?   @map("accepted_by_client_at") @db.Timestamptz
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  quote          Quote           @relation("QuoteVersions", fields: [quoteId], references: [id], onDelete: Cascade)
  createdBy      User?           @relation("QuoteVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  currentOf      Quote?          @relation("QuoteCurrentVersion")
  lines          QuoteLine[]
  changeRequests ChangeRequest[]
  // Invariant: tối đa một version ACCEPTED / quote (partial unique index trong migration).
  // Accepted version immutable (app + rule).

  @@unique([quoteId, versionNumber])
  @@index([quoteId])
  @@index([status])
  @@map("quote_versions")
}

model QuoteLine {
  id             String   @id @default(cuid()) @db.VarChar(30)
  quoteVersionId String   @map("quote_version_id") @db.VarChar(30)
  lineType       String   @default("custom") @map("line_type") @db.VarChar(30) // custom | package | addon
  referenceId    String?  @map("reference_id") @db.VarChar(30)
  description    String   @db.VarChar(500)
  details        String?  @db.Text // docs/31: immutable snapshot of the package inclusions at quote time
  quantity       Int      @default(1)
  unitPrice      Decimal  @default(0) @map("unit_price") @db.Decimal(12, 2)
  discount       Decimal  @default(0) @db.Decimal(12, 2)
  tax            Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal  @default(0) @map("line_total") @db.Decimal(12, 2)
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  quoteVersion QuoteVersion @relation(fields: [quoteVersionId], references: [id], onDelete: Cascade)

  @@index([quoteVersionId])
  @@map("quote_lines")
}

// ---------- Commercial: Contract ----------
// Sinh từ quote đã ACCEPTED. Client ký qua signToken (không login). Signed version immutable
// (partial unique + trigger trong migration). Amendment = version mới, không sửa bản đã ký.

model Contract {
  id               String         @id @default(cuid()) @db.VarChar(30)
  projectId        String         @map("project_id") @db.VarChar(30)
  signToken        String         @unique @map("sign_token") @db.VarChar(64) // client mở + ký qua link
  status           ContractStatus @default(DRAFT) // cache của current version
  currentVersionId String?        @unique @map("current_version_id") @db.VarChar(30)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  project        Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  currentVersion ContractVersion?  @relation("ContractCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       ContractVersion[] @relation("ContractVersions")

  @@index([projectId])
  @@map("contracts")
}

model ContractVersion {
  id                 String         @id @default(cuid()) @db.VarChar(30)
  contractId         String         @map("contract_id") @db.VarChar(30)
  versionNumber      Int            @map("version_number")
  status             ContractStatus @default(DRAFT)
  termsSnapshot      Json           @map("terms_snapshot") // ảnh chụp: client, project code, dòng quote + tổng
  contentHash        String?        @map("content_hash") @db.VarChar(64) // hash snapshot chứng minh bản ký không đổi
  createdByUserId    String?        @map("created_by_user_id") @db.VarChar(30)
  signedByClientName String?        @map("signed_by_client_name") @db.VarChar(150) // tên khách gõ khi ký
  signedByClientAt   DateTime?      @map("signed_by_client_at") @db.Timestamptz
  signedByClientIp   String?        @map("signed_by_client_ip") @db.VarChar(45)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  contract  Contract  @relation("ContractVersions", fields: [contractId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("ContractVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  currentOf Contract? @relation("ContractCurrentVersion")
  // Invariant: tối đa một version SIGNED / contract (partial unique index trong migration).
  // Signed version immutable (app + trigger).

  @@unique([contractId, versionNumber])
  @@index([contractId])
  @@index([status])
  @@map("contract_versions")
}

// ---------- Finance (Domain 05) ----------
// Hoá đơn xuất từ dự án CONFIRMED. amount_paid là cache; nguồn sự thật là PaymentTransaction
// (append-only). Void thay vì xoá. Billing snapshot giữ tính toàn vẹn hoá đơn thuế theo thời điểm.
// Stripe online để sau (env flag); slice này ghi nhận thanh toán thủ công (provider = manual).

model Invoice {
  id                     String        @id @default(cuid()) @db.VarChar(30)
  projectId              String        @map("project_id") @db.VarChar(30)
  invoiceNumber          String        @unique @map("invoice_number") @db.VarChar(30)
  type                   InvoiceType
  status                 InvoiceStatus @default(ISSUED)
  currency               String        @default("AUD") @db.VarChar(3)
  subtotal               Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal               Decimal       @default(0) @map("tax_total") @db.Decimal(12, 2)
  total                  Decimal       @default(0) @db.Decimal(12, 2)
  amountPaid             Decimal       @default(0) @map("amount_paid") @db.Decimal(12, 2) // cache; nguồn = transactions
  dueAt                  DateTime?     @map("due_at") @db.Timestamptz
  issuedAt               DateTime?     @map("issued_at") @db.Timestamptz
  billingNameSnapshot    String        @map("billing_name_snapshot") @db.VarChar(150)
  billingEmailSnapshot   String?       @map("billing_email_snapshot") @db.VarChar(255)
  // Editable-on-the-invoice contact + job label snapshots (the New invoice form can override these per
  // invoice without touching the master Client). Null falls back to the client/project at display time.
  billingPhoneSnapshot   String?       @map("billing_phone_snapshot") @db.VarChar(40)
  billingJobNameSnapshot String?       @map("billing_job_name_snapshot") @db.VarChar(150)
  invoiceDate            DateTime?     @map("invoice_date") @db.Timestamptz // document date shown on the invoice
  poNumber               String?       @map("po_number") @db.VarChar(60)
  notes                  String?       @db.Text // free-text notes printed on the invoice
  accessToken            String?       @unique @map("access_token") @db.VarChar(64) // client portal link
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  lines       InvoiceLine[]
  payments    Payment[]
  instalments InvoiceInstalment[]
  creditNotes CreditNote[]

  @@index([projectId])
  @@index([status])
  @@index([dueAt])
  @@map("invoices")
}

// A credit note reduces an issued invoice's OBLIGATION (docs/25 Rule M2/M8) without editing the
// original document. It is NOT a refund (that returns cash and lives in Refund/PaymentTransaction).
model CreditNote {
  id             String   @id @default(cuid()) @db.VarChar(30)
  invoiceId      String   @map("invoice_id") @db.VarChar(30)
  amount         Decimal  @db.Decimal(12, 2)
  reason         String?  @db.VarChar(500)
  issuedByUserId String?  @map("issued_by_user_id") @db.VarChar(30) // actor id (no FK; the AuditLog holds the trail)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("credit_notes")
}

/// A scheduled payment instalment on an invoice (Studio-Ninja "payment schedule"). The instalments
/// sum to the invoice total; recorded Payments pay them down (paid / due state is derived, money.ts).
model InvoiceInstalment {
  id        String    @id @default(cuid()) @db.VarChar(30)
  invoiceId String    @map("invoice_id") @db.VarChar(30)
  label     String?   @db.VarChar(100)
  dueAt     DateTime? @map("due_at") @db.Timestamptz
  amount    Decimal   @default(0) @db.Decimal(12, 2)
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_instalments")
}

model InvoiceLine {
  id          String   @id @default(cuid()) @db.VarChar(30)
  invoiceId   String   @map("invoice_id") @db.VarChar(30)
  itemName    String?  @map("item_name") @db.VarChar(200) // product/package name (bold heading); description holds the detail
  description String   @db.VarChar(500)
  quantity    Int      @default(1)
  unitPrice   Decimal  @default(0) @map("unit_price") @db.Decimal(12, 2)
  discount    Decimal  @default(0) @db.Decimal(12, 2) // amount off this line
  tax         Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal   Decimal  @default(0) @map("line_total") @db.Decimal(12, 2)
  sortOrder   Int      @default(0) @map("sort_order")
  source      String?  @db.VarChar(50) // vd add_on, extra_revision
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_lines")
}

model Payment {
  id               String        @id @default(cuid()) @db.VarChar(30)
  invoiceId        String        @map("invoice_id") @db.VarChar(30)
  projectId        String        @map("project_id") @db.VarChar(30)
  status           PaymentStatus @default(PAID) // PAID, then PARTIALLY_REFUNDED / REFUNDED after refunds
  amount           Decimal       @db.Decimal(12, 2)
  currency         String        @default("AUD") @db.VarChar(3)
  paymentMethod    PaymentMethod @map("payment_method")
  receivedAt       DateTime?     @map("received_at") @db.Timestamptz
  recordedByUserId String?       @map("recorded_by_user_id") @db.VarChar(30) // null nếu do gateway
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  invoice      Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  project      Project              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  recordedBy   User?                @relation("PaymentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  transactions PaymentTransaction[]
  refunds      Refund[]

  @@index([invoiceId])
  @@index([projectId])
  @@map("payments")
}

model PaymentTransaction {
  id                    String          @id @default(cuid()) @db.VarChar(30)
  paymentId             String          @map("payment_id") @db.VarChar(30)
  provider              String          @default("manual") @db.VarChar(30)
  externalTransactionId String?         @map("external_transaction_id") @db.VarChar(100) // id từ gateway
  type                  TransactionType
  amount                Decimal         @db.Decimal(12, 2)
  currency              String          @default("AUD") @db.VarChar(3)
  metadata              Json?
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  // APPEND-ONLY (trigger). uq(provider, externalTransactionId) khi external id có giá trị (idempotency).

  @@index([paymentId])
  @@map("payment_transactions")
}

// ---------- Governance / Reliability ----------

model AuditLog {
  id          String   @id @default(cuid()) @db.VarChar(30)
  companyId   String?  @map("company_id") @db.VarChar(30)
  actorUserId String?  @map("actor_user_id") @db.VarChar(30)
  action      String   @db.VarChar(100)
  entityType  String   @map("entity_type") @db.VarChar(50)
  entityId    String   @map("entity_id") @db.VarChar(30)
  beforeData  Json?    @map("before_data")
  afterData   Json?    @map("after_data")
  reason      String?  @db.VarChar(500)
  source      String?  @db.VarChar(50)
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  // INSERT-ONLY (trigger trong migration).

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// One notification to one recipient (docs/25 Part 4). The single send-retry unit: the payment reminder
// scanner queues every automatic email here (Rule N1).
model NotificationDispatch {
  id                     String    @id @default(cuid()) @db.VarChar(30)
  kind                   String    @db.VarChar(40) // payment_reminder | invoice_issued
  targetType             String    @map("target_type") @db.VarChar(30)
  targetId               String    @map("target_id") @db.VarChar(30)
  milestone              String    @db.VarChar(40) // e.g. due_-3 / due_0 / issued
  recipientHash          String    @map("recipient_hash") @db.VarChar(64)
  // UNIQUE: recreating (event re-processed, cron re-run) never inserts a duplicate (Rule N2).
  dedupeKey              String    @unique @map("dedupe_key") @db.VarChar(255)
  recipientEmail         String    @map("recipient_email") @db.VarChar(255)
  subject                String    @db.VarChar(255)
  body                   String    @db.Text
  // PENDING | SENDING | PROVIDER_ACCEPTED | FAILED | IN_DOUBT | SKIPPED_NO_PROVIDER (Rule N7).
  sendState              String    @default("PENDING") @map("send_state") @db.VarChar(30)
  // Separate axis from sendState (Rule N7): null | DELIVERED | BOUNCED | COMPLAINED (from the webhook).
  deliveryResult         String?   @map("delivery_result") @db.VarChar(20)
  attempts               Int       @default(0)
  lockedBy               String?   @map("locked_by") @db.VarChar(64)
  lockedUntil            DateTime? @map("locked_until") @db.Timestamptz
  leaseToken             String?   @map("lease_token") @db.VarChar(64)
  providerIdempotencyKey String    @map("provider_idempotency_key") @db.VarChar(255)
  providerMessageId      String?   @map("provider_message_id") @db.VarChar(255)
  firstSentToProviderAt  DateTime? @map("first_sent_to_provider_at") @db.Timestamptz
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([sendState])
  @@index([providerMessageId])
  @@map("notification_dispatches")
}

// Raw delivery signals from the provider webhook (docs/25 Rule N8). Deduped by providerEventId; may
// arrive before the dispatch row exists (buffered, reconciled by providerMessageId later).
model NotificationDeliveryEvent {
  id                String   @id @default(cuid()) @db.VarChar(30)
  providerEventId   String   @unique @map("provider_event_id") @db.VarChar(255)
  providerMessageId String   @map("provider_message_id") @db.VarChar(255)
  type              String   @db.VarChar(20) // delivered | bounced | complained
  dispatchId        String?  @map("dispatch_id") @db.VarChar(30) // set once reconciled to a dispatch
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([providerMessageId])
  @@map("notification_delivery_events")
}

// A recipient address marked bad by a hard bounce / complaint (Rule N8): auto-reminders to it stop.
model NotificationSuppression {
  recipientHash  String   @id @map("recipient_hash") @db.VarChar(64)
  recipientEmail String   @map("recipient_email") @db.VarChar(255)
  reason         String   @db.VarChar(20) // bounced | complained
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("notification_suppressions")
}

// ---------- Backlog: collaboration, changes, finance edges (docs/16 E-J) ----------

// A lead's first message from the website form, and the team's internal notes on a lead or job.
model Communication {
  id             String            @id @default(cuid()) @db.VarChar(30)
  projectId      String?           @map("project_id") @db.VarChar(30)
  enquiryId      String?           @map("enquiry_id") @db.VarChar(30)
  clientId       String?           @map("client_id") @db.VarChar(30)
  type           CommunicationType
  direction      String            @db.VarChar(10) // inbound | outbound
  subject        String?           @db.VarChar(255)
  body           String            @db.Text
  internal       Boolean           @default(false) // true = internal team note (not client-facing)
  byUserId       String?           @map("by_user_id") @db.VarChar(30) // null khi do client/hệ thống
  editedByUserId String?           @map("edited_by_user_id") @db.VarChar(30) // staff who last edited (internal notes)
  editedAt       DateTime?         @map("edited_at") @db.Timestamptz
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz

  project  Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client   Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  by       User?    @relation("CommunicationBy", fields: [byUserId], references: [id], onDelete: SetNull)
  editedBy User?    @relation("CommunicationEditedBy", fields: [editedByUserId], references: [id], onDelete: SetNull)
  enquiry  Enquiry? @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([enquiryId, createdAt])
  @@map("communications")
}

// Single task concept for a case's workflow (contract docs/23). Attached to an enquiry or a project.
model WorkItem {
  id                String         @id @default(cuid()) @db.VarChar(30)
  companyId         String         @map("company_id") @db.VarChar(30)
  enquiryId         String?        @map("enquiry_id") @db.VarChar(30)
  projectId         String?        @map("project_id") @db.VarChar(30)
  kind              String         @db.VarChar(50) // e.g. REVIEW_ENQUIRY, or CUSTOM for a staff-added task
  stage             String?        @db.VarChar(50) // workflow group key (project checklist): preshoot, shoot, ...
  type              String         @default("TODO") @db.VarChar(20) // TODO | AUTO_EMAIL | APPOINTMENT | SHOOT | AUTO
  title             String         @db.VarChar(150)
  status            WorkItemStatus @default(PENDING)
  order             Int            @default(0)
  dueAt             DateTime?      @map("due_at") @db.Timestamptz // enquiry/lead tasks: manual/anchored date (project tasks use the fields below)
  // Deadline foundation (docs/25 Part 2): project tasks derive their due date from an anchor + offset,
  // resolved by resolveTaskDueDate. A manual date is dueOverrideAt (Rule D1), never a MANUAL anchor.
  dueAnchor         DueAnchor?     @map("due_anchor")
  dueOffsetDays     Int            @default(0) @map("due_offset_days") // days from the anchor (negative = before)
  dueDateFixed      DateTime?      @map("due_date_fixed") @db.Timestamptz // the date for anchor = FIXED
  dueOverrideAt     DateTime?      @map("due_override_at") @db.Timestamptz // staff manual override; null = follow the anchor
  completedByUserId String?        @map("completed_by_user_id") @db.VarChar(30)
  completedAt       DateTime?      @map("completed_at") @db.Timestamptz
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  enquiry     Enquiry? @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  completedBy User?    @relation("WorkItemCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)

  @@index([enquiryId])
  @@index([projectId])
  @@map("work_items")
}

/// A calendar entry staff add directly, outside the workflow: an appointment, an extra shoot, or
/// another studio event. Job shoots come from each job's Shoot task and appointments from WorkItem;
/// this model covers everything staff want on the calendar without opening a case (BR-CAL).
model CalendarEvent {
  id              String    @id @default(cuid()) @db.VarChar(30)
  companyId       String    @map("company_id") @db.VarChar(30)
  kind            String    @default("APPOINTMENT") @db.VarChar(20) // APPOINTMENT | SHOOT | OTHER
  title           String    @db.VarChar(200)
  startsAt        DateTime  @map("starts_at") @db.Timestamptz
  endsAt          DateTime? @map("ends_at") @db.Timestamptz
  allDay          Boolean   @default(false) @map("all_day")
  location        String?   @db.VarChar(255)
  notes           String?   @db.Text
  clientId        String?   @map("client_id") @db.VarChar(30)
  createdByUserId String?   @map("created_by_user_id") @db.VarChar(30)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client    Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdBy User?   @relation("CalendarEventCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([startsAt])
  @@map("calendar_events")
}

// Refund against a captured payment. Total refunds never exceed the captured amount (domain check);
// the money movement is also written as a REFUND PaymentTransaction (append-only).
model Refund {
  id                String   @id @default(cuid()) @db.VarChar(30)
  paymentId         String   @map("payment_id") @db.VarChar(30)
  amount            Decimal  @db.Decimal(12, 2)
  currency          String   @default("AUD") @db.VarChar(3)
  reason            String?  @db.VarChar(500)
  externalReference String?  @map("external_reference") @db.VarChar(100)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@map("refunds")
}

// A post-confirmation change request, routed by type. Never edits records in place: a commercial
// change spawns a new quote version, a reschedule moves the job's Shoot task date, data an audited client edit.
model ChangeRequest {
  id                      String              @id @default(cuid()) @db.VarChar(30)
  projectId               String              @map("project_id") @db.VarChar(30)
  type                    ChangeRequestType
  status                  ChangeRequestStatus @default(PENDING)
  requestedByType         String              @map("requested_by_type") @db.VarChar(10) // staff | client
  requestedByUserId       String?             @map("requested_by_user_id") @db.VarChar(30)
  description             String              @db.Text
  reason                  String?             @db.VarChar(500)
  commercialImpact        Decimal?            @map("commercial_impact") @db.Decimal(12, 2)
  // Typed composite payload + its version (docs/25 Rule C2); a payload edited after approval bumps the
  // version and invalidates the prior approval/assessment.
  payload                 Json?
  // Drift snapshot taken at assessment (Rule C4): apply re-reads and blocks if either changed.
  assessedShootDate       String?             @map("assessed_shoot_date") @db.VarChar(64)
  assessedQuoteVersionId  String?             @map("assessed_quote_version_id") @db.VarChar(30)
  // Client agreement is a separate fact from internal approval and from application (Rule C1).
  clientAgreedVia         String?             @map("client_agreed_via") @db.VarChar(30)
  clientAgreedAt          DateTime?           @map("client_agreed_at") @db.Timestamptz
  clientAgreedByUserId    String?             @map("client_agreed_by_user_id") @db.VarChar(30)
  agreedQuoteVersionId    String?             @map("agreed_quote_version_id") @db.VarChar(30)
  resultingQuoteVersionId String?             @map("resulting_quote_version_id") @db.VarChar(30)
  approvedByUserId        String?             @map("approved_by_user_id") @db.VarChar(30)
  approvedAt              DateTime?           @map("approved_at") @db.Timestamptz
  appliedAt               DateTime?           @map("applied_at") @db.Timestamptz
  rejectedAt              DateTime?           @map("rejected_at") @db.Timestamptz
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  project               Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedBy           User?         @relation("ChangeRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  approvedBy            User?         @relation("ChangeApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  resultingQuoteVersion QuoteVersion? @relation(fields: [resultingQuoteVersionId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([status])
  @@map("change_requests")
}

/// Confirmed client preferences/requests/restrictions for a Job, shown on the Overview tab.
model ProjectRequirement {
  id        String   @id @default(cuid()) @db.VarChar(30)
  projectId String   @map("project_id") @db.VarChar(30)
  label     String   @db.VarChar(120)
  detail    String   @db.Text
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_requirements")
}

/// A person responsible for a Job (Lead Photographer, Editor, Coordinator, ...).
model ProjectTeamMember {
  id        String   @id @default(cuid()) @db.VarChar(30)
  projectId String   @map("project_id") @db.VarChar(30)
  name      String   @db.VarChar(150)
  role      String   @db.VarChar(80)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_team_members")
}
