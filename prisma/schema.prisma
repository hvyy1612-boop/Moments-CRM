// Moments — Prisma schema. Project-centric (Database Blueprint v2 final).
// Slices 1-5: Company, auth (User/Session/PasswordReset/SecurityEvent), Client, Project,
// Quote/QuoteVersion/QuoteLine, Contract/ContractVersion, Booking/Resource/ResourceAssignment,
// Invoice/InvoiceLine/Payment/PaymentTransaction, Gallery/GalleryItem, AuditLog, OutboxEvent.
// Later slices add: workflow/work_items, deliverables/revisions/approvals/assets (object storage),
// notifications, policies, change_requests, refunds, Stripe online payment, etc.
//
// Naming: code = camelCase field + PascalCase model; database = snake_case column + snake_case
// plural table (via @map / @@map). See docs/17-data-dictionary.md for the full mapping.
//
// Locked decisions: single-tenant (one Company row; company_id là reserved field, không RLS),
// project bắt đầu từ enquiry, không leads, work_items canonical (chưa dựng ở slice 1),
// CUID id, money Decimal, timestamptz. Con số business = TBD (không hard-code).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  // btree_gist: cho phép EXCLUDE constraint chống một resource nhận hai assignment chồng giờ.
  extensions = [citext, btree_gist]
}

// ---------- Enums ----------

enum UserRole {
  ADMIN
  STUDIO
  EDITOR
}

enum SecurityOutcome {
  SUCCESS
  FAILURE
}

enum ClientType {
  INDIVIDUAL
  BUSINESS
}

enum ClientStatus {
  PROSPECT
  ACTIVE
  ARCHIVED
}

// Coarse business stage of a Project (P2: gọn, không nhét scheduling/production vào đây).
enum ProjectLifecycle {
  ENQUIRY
  QUALIFYING
  QUOTING
  AWAITING_DECISION
  CONFIRMED
  IN_PRODUCTION
  COMPLETED
  CANCELLED
}

// Derived dimension. Slice 1 dùng lifecycle + commercial; các chiều khác thêm ở slice sau.
enum CommercialStatus {
  UNQUOTED
  QUOTED
  ACCEPTED
  DEPOSIT_PAID
  PAID
  CANCELLED
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
  SUPERSEDED
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  SUPERSEDED
  VOID
}

enum BookingStatus {
  TENTATIVE
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ResourceType {
  PHOTOGRAPHER
  VIDEOGRAPHER
  SECOND_SHOOTER
  EDITOR
  STUDIO
  EQUIPMENT
}

enum AssignmentStatus {
  ACTIVE
  CANCELLED
}

enum InvoiceType {
  DEPOSIT
  BALANCE
  SUPPLEMENTARY
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum PaymentStatus {
  UNPAID
  PENDING
  PARTIALLY_PAID
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD
  CASH
  OTHER
}

enum TransactionType {
  CHARGE
  REFUND
  REVERSAL
}

enum TransactionStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum GalleryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

// ---------- Company (single tenant) ----------

model Company {
  id        String   @id @default(cuid())
  name      String
  abn       String? // OQ-007 placeholder cho tới khi xác nhận
  timezone  String   @default("Australia/Sydney")
  currency  String   @default("AUD")
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  users     User[]
  clients   Client[]
  projects  Project[]
  bookings  Booking[]
  resources Resource[]

  @@map("companies")
}

// ---------- Identity / auth (giữ nguyên hình dạng để code auth tái dùng) ----------

model User {
  id                 String    @id @default(cuid())
  companyId          String    @map("company_id")
  email              String    @unique @db.Citext
  passwordHash       String    @map("password_hash")
  passwordAlgo       String    @map("password_algo")
  role               UserRole
  name               String
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz
  failedAttempts     Int       @default(0) @map("failed_attempts")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz
  passwordChangedAt  DateTime? @map("password_changed_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company                 Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  passwordResets          PasswordReset[]
  sessions                Session[]
  securityEvents          SecurityEvent[]
  auditLogs               AuditLog[]
  ownedProjects           Project[]            @relation("ProjectOwner")
  createdQuoteVersions    QuoteVersion[]       @relation("QuoteVersionCreatedBy")
  createdContractVersions ContractVersion[]    @relation("ContractVersionCreatedBy")
  linkedResources         Resource[]           @relation("ResourceUser")
  assignmentsMade         ResourceAssignment[] @relation("AssignmentAssignedBy")
  recordedPayments        Payment[]            @relation("PaymentRecordedBy")

  @@index([companyId])
  @@index([role])
  @@map("users")
}

model PasswordReset {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  tokenHash   String    @map("token_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  usedAt      DateTime? @map("used_at") @db.Timestamptz
  requestedIp String    @map("requested_ip")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_resets")
}

model Session {
  id                String    @id @default(cuid())
  userId            String    @map("user_id")
  tokenHash         String    @map("token_hash")
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz
  lastActiveAt      DateTime  @default(now()) @map("last_active_at") @db.Timestamptz
  userAgent         String?   @map("user_agent")
  ipAddress         String?   @map("ip_address")
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("sessions")
}

model SecurityEvent {
  id             String          @id @default(cuid())
  eventType      String          @map("event_type")
  userId         String?         @map("user_id")
  emailAttempted String?         @map("email_attempted") @db.Citext
  ipAddress      String          @map("ip_address")
  userAgent      String?         @map("user_agent")
  outcome        SecurityOutcome
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  // INSERT-ONLY (trigger trong migration).

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
  @@map("security_events")
}

// ---------- CRM ----------

model Client {
  id               String       @id @default(cuid())
  companyId        String       @map("company_id")
  type             ClientType   @default(INDIVIDUAL)
  status           ClientStatus @default(PROSPECT)
  displayName      String       @map("display_name")
  legalName        String?      @map("legal_name")
  email            String       @unique @db.Citext // dedupe tại enquiry (P1)
  phone            String?
  suburb           String?
  state            String?
  postcode         String?
  marketingConsent Boolean      @default(false) @map("marketing_consent")
  consentUpdatedAt DateTime?    @map("consent_updated_at") @db.Timestamptz
  anonymisedAt     DateTime?    @map("anonymised_at") @db.Timestamptz
  notes            String?
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt       DateTime?    @map("archived_at") @db.Timestamptz

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  projects Project[]

  @@index([companyId])
  @@index([status])
  @@map("clients")
}

// ---------- Project (operational case, bắt đầu từ enquiry) ----------

model Project {
  id                String           @id @default(cuid())
  companyId         String           @map("company_id")
  clientId          String           @map("client_id")
  code              String           @unique
  name              String
  ownerUserId       String?          @map("owner_user_id")
  lifecycleStatus   ProjectLifecycle @default(ENQUIRY) @map("lifecycle_status")
  commercialStatus  CommercialStatus @default(UNQUOTED) @map("commercial_status") // derived
  source            String? // nguồn enquiry (I-6 taxonomy, TBD)
  sourceDetail      String?          @map("source_detail")
  enquiryReceivedAt DateTime         @default(now()) @map("enquiry_received_at") @db.Timestamptz
  enquiryNotes      String?          @map("enquiry_notes")
  firstRespondedAt  DateTime?        @map("first_responded_at") @db.Timestamptz // SLA
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt        DateTime?        @map("archived_at") @db.Timestamptz

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  client    Client     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  owner     User?      @relation("ProjectOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  quotes    Quote[]
  contracts Contract[]
  bookings  Booking[]
  invoices  Invoice[]
  payments  Payment[]
  galleries Gallery[]

  @@index([companyId])
  @@index([clientId])
  @@index([lifecycleStatus])
  @@index([enquiryReceivedAt])
  @@map("projects")
}

// ---------- Commercial: Quote ----------

model Quote {
  id               String      @id @default(cuid())
  projectId        String      @map("project_id")
  viewToken        String      @unique @map("view_token") // client xem quote qua link, đọc current version
  status           QuoteStatus @default(DRAFT) // cache của current version
  currentVersionId String?     @unique @map("current_version_id")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  project        Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  currentVersion QuoteVersion?  @relation("QuoteCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       QuoteVersion[] @relation("QuoteVersions")

  @@index([projectId])
  @@map("quotes")
}

model QuoteVersion {
  id                   String      @id @default(cuid())
  quoteId              String      @map("quote_id")
  versionNumber        Int         @map("version_number")
  status               QuoteStatus @default(DRAFT)
  currency             String      @default("AUD")
  subtotal             Decimal     @default(0) @db.Decimal(12, 2)
  discountTotal        Decimal     @default(0) @map("discount_total") @db.Decimal(12, 2)
  taxTotal             Decimal     @default(0) @map("tax_total") @db.Decimal(12, 2)
  total                Decimal     @default(0) @db.Decimal(12, 2)
  validUntil           DateTime?   @map("valid_until") @db.Timestamptz
  createdByUserId      String?     @map("created_by_user_id")
  sentToClientAt       DateTime?   @map("sent_to_client_at") @db.Timestamptz
  viewedByClientAt     DateTime?   @map("viewed_by_client_at") @db.Timestamptz
  acceptedByClientAt   DateTime?   @map("accepted_by_client_at") @db.Timestamptz
  acceptedByClientName String?     @map("accepted_by_client_name") // tên khách gõ khi accept
  acceptedByClientIp   String?     @map("accepted_by_client_ip")
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  quote     Quote       @relation("QuoteVersions", fields: [quoteId], references: [id], onDelete: Cascade)
  createdBy User?       @relation("QuoteVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  currentOf Quote?      @relation("QuoteCurrentVersion")
  lines     QuoteLine[]
  // Invariant: tối đa một version ACCEPTED / quote (partial unique index trong migration).
  // Accepted version immutable (app + rule).

  @@unique([quoteId, versionNumber])
  @@index([quoteId])
  @@index([status])
  @@map("quote_versions")
}

model QuoteLine {
  id             String   @id @default(cuid())
  quoteVersionId String   @map("quote_version_id")
  lineType       String   @default("custom") @map("line_type") // custom | package | addon (slice 1: custom)
  referenceId    String?  @map("reference_id")
  description    String
  quantity       Int      @default(1)
  unitPrice      Decimal  @default(0) @map("unit_price") @db.Decimal(12, 2)
  discount       Decimal  @default(0) @db.Decimal(12, 2)
  tax            Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal  @default(0) @map("line_total") @db.Decimal(12, 2)
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  quoteVersion QuoteVersion @relation(fields: [quoteVersionId], references: [id], onDelete: Cascade)

  @@index([quoteVersionId])
  @@map("quote_lines")
}

// ---------- Commercial: Contract ----------
// Sinh từ quote đã ACCEPTED. Client ký qua signToken (không login). Signed version immutable
// (partial unique + trigger trong migration). Amendment = version mới, không sửa bản đã ký.

model Contract {
  id               String         @id @default(cuid())
  projectId        String         @map("project_id")
  signToken        String         @unique @map("sign_token") // client mở + ký contract qua link, không cần account
  status           ContractStatus @default(DRAFT) // cache của current version
  currentVersionId String?        @unique @map("current_version_id")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  project        Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  currentVersion ContractVersion?  @relation("ContractCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       ContractVersion[] @relation("ContractVersions")

  @@index([projectId])
  @@map("contracts")
}

model ContractVersion {
  id                 String         @id @default(cuid())
  contractId         String         @map("contract_id")
  versionNumber      Int            @map("version_number")
  status             ContractStatus @default(DRAFT)
  documentReference  String?        @map("document_reference") // link/ref tới bản PDF nếu có (chưa dựng ở slice này)
  termsSnapshot      Json           @map("terms_snapshot") // ảnh chụp: client, project code, dòng quote + tổng, nội dung điều khoản
  contentHash        String?        @map("content_hash") // hash của snapshot để chứng minh bản ký không đổi
  createdByUserId    String?        @map("created_by_user_id")
  signedByClientName String?        @map("signed_by_client_name") // tên khách gõ khi ký
  signedByClientAt   DateTime?      @map("signed_by_client_at") @db.Timestamptz
  signedByClientIp   String?        @map("signed_by_client_ip")
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  contract  Contract  @relation("ContractVersions", fields: [contractId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("ContractVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  currentOf Contract? @relation("ContractCurrentVersion")
  // Invariant: tối đa một version SIGNED / contract (partial unique index trong migration).
  // Signed version immutable (app + trigger).

  @@unique([contractId, versionNumber])
  @@index([contractId])
  @@index([status])
  @@map("contract_versions")
}

// ---------- Scheduling (Domain 06) ----------
// Một dự án CONFIRMED có thể có nhiều buổi chụp (engagement, ngày cưới...). Mỗi buổi gán ekip/thiết
// bị qua ResourceAssignment; một resource không thể nhận hai assignment ACTIVE chồng thời gian
// (EXCLUDE USING gist trong migration, cần extension btree_gist).

model Booking {
  id          String        @id @default(cuid())
  companyId   String        @map("company_id")
  projectId   String        @map("project_id")
  title       String?
  status      BookingStatus @default(TENTATIVE)
  startsAt    DateTime      @map("starts_at") @db.Timestamptz
  endsAt      DateTime      @map("ends_at") @db.Timestamptz
  timezone    String        @default("Australia/Sydney")
  location    String?
  notes       String?
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  cancelledAt DateTime?     @map("cancelled_at") @db.Timestamptz

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project     Project              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  assignments ResourceAssignment[]

  @@index([projectId])
  @@index([status])
  @@index([startsAt])
  @@map("bookings")
}

model Resource {
  id           String       @id @default(cuid())
  companyId    String       @map("company_id")
  resourceType ResourceType @map("resource_type")
  name         String
  linkedUserId String?      @map("linked_user_id") // nếu resource là một nhân sự có tài khoản
  status       String       @default("active")
  metadata     Json?
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  linkedUser  User?                @relation("ResourceUser", fields: [linkedUserId], references: [id], onDelete: SetNull)
  assignments ResourceAssignment[]

  @@index([companyId, resourceType])
  @@map("resources")
}

model ResourceAssignment {
  id               String           @id @default(cuid())
  bookingId        String           @map("booking_id")
  resourceId       String           @map("resource_id")
  role             String?
  startsAt         DateTime         @map("starts_at") @db.Timestamptz // = cửa sổ thời gian của booking khi gán
  endsAt           DateTime         @map("ends_at") @db.Timestamptz
  status           AssignmentStatus @default(ACTIVE)
  assignedByUserId String?          @map("assigned_by_user_id")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  assignedBy User?    @relation("AssignmentAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  // Invariant: một resource không nhận hai assignment ACTIVE chồng thời gian
  // (EXCLUDE USING gist trên (resourceId, tstzrange(startsAt, endsAt)) WHERE status='ACTIVE').

  @@index([resourceId])
  @@index([bookingId])
  @@map("resource_assignments")
}

// ---------- Finance (Domain 05) ----------
// Hoá đơn xuất từ dự án CONFIRMED. amount_paid là cache; nguồn sự thật là PaymentTransaction
// (append-only). Void thay vì xoá. Billing snapshot giữ tính toàn vẹn hoá đơn thuế theo thời điểm.
// Stripe online để sau (env flag); slice này ghi nhận thanh toán thủ công (provider = manual).

model Invoice {
  id                   String        @id @default(cuid())
  projectId            String        @map("project_id")
  invoiceNumber        String        @unique @map("invoice_number")
  type                 InvoiceType
  status               InvoiceStatus @default(DRAFT)
  currency             String        @default("AUD")
  subtotal             Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal             Decimal       @default(0) @map("tax_total") @db.Decimal(12, 2)
  total                Decimal       @default(0) @db.Decimal(12, 2)
  amountPaid           Decimal       @default(0) @map("amount_paid") @db.Decimal(12, 2) // cache; source of truth = transactions
  dueAt                DateTime?     @map("due_at") @db.Timestamptz
  issuedAt             DateTime?     @map("issued_at") @db.Timestamptz
  billingNameSnapshot  String        @map("billing_name_snapshot")
  billingEmailSnapshot String?       @map("billing_email_snapshot")
  voidedAt             DateTime?     @map("voided_at") @db.Timestamptz
  voidReason           String?       @map("void_reason")
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  lines    InvoiceLine[]
  payments Payment[]

  @@index([projectId])
  @@index([status])
  @@index([dueAt])
  @@map("invoices")
}

model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String   @map("invoice_id")
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @default(0) @map("unit_price") @db.Decimal(12, 2)
  tax         Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal   Decimal  @default(0) @map("line_total") @db.Decimal(12, 2)
  sortOrder   Int      @default(0) @map("sort_order")
  source      String? // vd add_on, extra_revision
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_lines")
}

model Payment {
  id               String        @id @default(cuid())
  invoiceId        String        @map("invoice_id")
  projectId        String        @map("project_id")
  status           PaymentStatus @default(PENDING) // derived từ transactions
  amount           Decimal       @db.Decimal(12, 2)
  currency         String        @default("AUD")
  paymentMethod    PaymentMethod @map("payment_method")
  receivedAt       DateTime?     @map("received_at") @db.Timestamptz
  recordedByUserId String?       @map("recorded_by_user_id") // null nếu do gateway
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  invoice      Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  project      Project              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  recordedBy   User?                @relation("PaymentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  transactions PaymentTransaction[]

  @@index([invoiceId])
  @@index([projectId])
  @@map("payments")
}

model PaymentTransaction {
  id                    String            @id @default(cuid())
  paymentId             String            @map("payment_id")
  provider              String            @default("manual")
  externalTransactionId String?           @map("external_transaction_id") // id từ gateway, để idempotent
  type                  TransactionType
  amount                Decimal           @db.Decimal(12, 2)
  currency              String            @default("AUD")
  status                TransactionStatus @default(SUCCEEDED)
  processedAt           DateTime?         @map("processed_at") @db.Timestamptz
  metadata              Json?
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  // APPEND-ONLY (trigger). uq(provider, externalTransactionId) khi external id có giá trị (idempotency).

  @@index([paymentId])
  @@map("payment_transactions")
}

// ---------- Production / Delivery (Domain 08) ----------
// Slice 5 subset: giao khách qua Gallery. Client mở gallery bằng accessToken (không login). Publish
// gallery = đã giao → dự án COMPLETED. Asset/object storage, revisions, approvals để dành slice sau;
// item hiện lưu URL ngoài (studio host ảnh ở nơi khác) thay vì tự lưu file.

model Gallery {
  id          String        @id @default(cuid())
  projectId   String        @map("project_id")
  title       String
  status      GalleryStatus @default(DRAFT)
  accessToken String        @unique @map("access_token") // client xem gallery qua link, không cần account
  publishedAt DateTime?     @map("published_at") @db.Timestamptz
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  project Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  items   GalleryItem[]

  @@index([projectId])
  @@map("galleries")
}

model GalleryItem {
  id        String   @id @default(cuid())
  galleryId String   @map("gallery_id")
  caption   String
  url       String // link http/https tới ảnh/tài nguyên (validate ở app; chặn javascript:)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  gallery Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  @@index([galleryId])
  @@map("gallery_items")
}

// ---------- Governance / Reliability ----------

model AuditLog {
  id          String   @id @default(cuid())
  companyId   String?  @map("company_id")
  actorUserId String?  @map("actor_user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  beforeData  Json?    @map("before_data")
  afterData   Json?    @map("after_data")
  reason      String?
  source      String?
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  // INSERT-ONLY (trigger trong migration).

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model OutboxEvent {
  id            String       @id @default(cuid())
  eventType     String       @map("event_type")
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id")
  correlationId String?      @map("correlation_id")
  causationId   String?      @map("causation_id")
  payload       Json
  status        OutboxStatus @default(PENDING)
  attemptCount  Int          @default(0) @map("attempt_count")
  availableAt   DateTime     @default(now()) @map("available_at") @db.Timestamptz
  processedAt   DateTime?    @map("processed_at") @db.Timestamptz
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz

  @@index([status, availableAt])
  @@map("outbox_events")
}
