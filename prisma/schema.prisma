
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [citext, btree_gist]
}

enum UserRole {
  ADMIN
  STUDIO
  EDITOR
}

enum SecurityOutcome {
  SUCCESS
  FAILURE
}

enum ClientType {
  INDIVIDUAL
  BUSINESS
}

enum ClientStatus {
  PROSPECT
  ACTIVE
  ARCHIVED
}

enum ProjectLifecycle {
  ENQUIRY
  QUALIFYING
  QUOTING
  AWAITING_DECISION
  NEGOTIATION
  BOOKING_REQUESTED
  CONFIRMED
  IN_PRODUCTION
  COMPLETED
  CANCELLED
  LOST
  ON_HOLD
  POSTPONED
  ARCHIVED
}

enum CommercialStatus {
  UNQUOTED
  QUOTED
  ACCEPTED
  DEPOSIT_PAID
  PAID
  CANCELLED
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
  SUPERSEDED
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  SUPERSEDED
  VOID
}

enum BookingStatus {
  TENTATIVE
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ResourceType {
  PHOTOGRAPHER
  VIDEOGRAPHER
  SECOND_SHOOTER
  EDITOR
  STUDIO
  EQUIPMENT
}

enum AssignmentStatus {
  ACTIVE
  CANCELLED
}

enum InvoiceType {
  DEPOSIT
  BALANCE
  SUPPLEMENTARY
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum PaymentStatus {
  UNPAID
  PENDING
  PARTIALLY_PAID
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD
  CASH
  OTHER
}

enum TransactionType {
  CHARGE
  REFUND
  REVERSAL
}

enum TransactionStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum GalleryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum EnquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
  ARCHIVED
}

enum WaitingOn {
  STUDIO
  CLIENT
}

enum WorkItemStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum EnquirySource {
  WEBSITE
  REFERRAL
  INSTAGRAM
  MANUAL
  OTHER
}

enum ClientSource {
  DIRECT_BOOKING
  ENQUIRY
  REFERRAL
  MANUAL
  OTHER
}

enum DeclineReason {
  PRICE
  DATE_UNAVAILABLE
  CHOSE_ANOTHER
  PACKAGE_UNSUITABLE
  NO_LONGER_NEED
  OTHER
}

enum ContactRole {
  PRIMARY
  PARTNER
  BILLING
  OTHER
}

enum CommunicationType {
  EMAIL
  NOTE
  CLIENT_MESSAGE
  CALL
}

enum ChangeRequestType {
  COMMERCIAL
  OPERATIONAL
  CLIENT_DATA
  PRODUCTION
}

enum ChangeRequestStatus {
  PENDING
  IMPACT_ASSESSMENT
  APPROVED
  REJECTED
  APPLIED
}

enum FileKind {
  CONTRACT
  QUESTIONNAIRE
  RAW
  EDITED
  PROOF
  GALLERY
  INVOICE
  OTHER
}

enum FileVisibility {
  INTERNAL
  CLIENT_VISIBLE
}

enum QuestionnaireStatus {
  PENDING
  COMPLETED
}

model Company {
  id        String   @id @default(cuid()) @db.VarChar(30)
  name      String   @db.VarChar(150)
  abn       String?  @db.VarChar(20)
  timezone  String   @default("Australia/Sydney") @db.VarChar(50)
  currency  String   @default("AUD") @db.VarChar(3)
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  users     User[]
  clients   Client[]
  projects  Project[]
  enquiries Enquiry[]
  packages  Package[]
  bookings  Booking[]
  resources Resource[]
  workItems WorkItem[]

  @@map("companies")
}

model User {
  id                 String    @id @default(cuid()) @db.VarChar(30)
  companyId          String    @map("company_id") @db.VarChar(30)
  email              String    @unique @db.Citext
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  passwordAlgo       String    @map("password_algo") @db.VarChar(30)
  role               UserRole
  name               String    @db.VarChar(150)
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz
  failedAttempts     Int       @default(0) @map("failed_attempts")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz
  passwordChangedAt  DateTime? @map("password_changed_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company                 Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  passwordResets          PasswordReset[]
  sessions                Session[]
  signInLogs          SignInLog[]
  auditLogs               AuditLog[]
  ownedProjects           Project[]            @relation("ProjectOwner")
  createdQuoteVersions    QuoteVersion[]       @relation("QuoteVersionCreatedBy")
  createdContractVersions ContractVersion[]    @relation("ContractVersionCreatedBy")
  linkedResources         Resource[]           @relation("ResourceUser")
  assignmentsMade         ResourceAssignment[] @relation("AssignmentAssignedBy")
  recordedPayments        Payment[]            @relation("PaymentRecordedBy")
  ownedEnquiries          Enquiry[]            @relation("EnquiryOwner")
  communications          Communication[]
  uploadedFiles           File[]
  requestedChanges        ChangeRequest[]      @relation("ChangeRequestedBy")
  approvedChanges         ChangeRequest[]      @relation("ChangeApprovedBy")
  completedWorkItems      WorkItem[]           @relation("WorkItemCompletedBy")

  @@index([companyId])
  @@index([role])
  @@map("users")
}

model PasswordReset {
  id          String    @id @default(cuid()) @db.VarChar(30)
  userId      String    @map("user_id") @db.VarChar(30)
  tokenHash   String    @map("token_hash") @db.VarChar(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  usedAt      DateTime? @map("used_at") @db.Timestamptz
  requestedIp String    @map("requested_ip") @db.VarChar(45)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_resets")
}

model Session {
  id                String    @id @default(cuid()) @db.VarChar(30)
  userId            String    @map("user_id") @db.VarChar(30)
  tokenHash         String    @map("token_hash") @db.VarChar(64)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz
  lastActiveAt      DateTime  @default(now()) @map("last_active_at") @db.Timestamptz
  userAgent         String?   @map("user_agent") @db.VarChar(400)
  ipAddress         String?   @map("ip_address") @db.VarChar(45)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("sessions")
}

model SignInLog {
  id             String          @id @default(cuid()) @db.VarChar(30)
  eventType      String          @map("event_type") @db.VarChar(100)
  userId         String?         @map("user_id") @db.VarChar(30)
  emailAttempted String?         @map("email_attempted") @db.Citext
  ipAddress      String          @map("ip_address") @db.VarChar(45)
  userAgent      String?         @map("user_agent") @db.VarChar(400)
  outcome        SecurityOutcome
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
  @@map("security_events")
}

model Client {
  id                 String       @id @default(cuid()) @db.VarChar(30)
  companyId          String       @map("company_id") @db.VarChar(30)
  type               ClientType   @default(INDIVIDUAL)
  status             ClientStatus @default(PROSPECT)
  source             ClientSource @default(MANUAL)
  displayName        String       @map("display_name") @db.VarChar(150)
  legalName          String?      @map("legal_name") @db.VarChar(150)
  firstName          String?      @map("first_name") @db.VarChar(80)
  lastName           String?      @map("last_name") @db.VarChar(80)
  email              String       @unique @db.Citext
  phone              String?      @db.VarChar(30)
  street             String?      @db.VarChar(200)
  suburb             String?      @db.VarChar(100)
  state              String?      @db.VarChar(100)
  postcode           String?      @db.VarChar(20)
  country            String?      @db.VarChar(100)
  marketingConsent   Boolean      @default(false) @map("marketing_consent")
  consentUpdatedAt   DateTime?    @map("consent_updated_at") @db.Timestamptz
  anonymisedAt       DateTime?    @map("anonymised_at") @db.Timestamptz
  notes              String?      @db.Text
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt         DateTime?    @map("archived_at") @db.Timestamptz
  mergedIntoClientId String?      @map("merged_into_client_id") @db.VarChar(30)

  company                Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  projects               Project[]
  convertedFromEnquiries Enquiry[]       @relation("EnquiryConvertedClient")
  mergedInto             Client?         @relation("ClientMerge", fields: [mergedIntoClientId], references: [id], onDelete: SetNull)
  mergedFrom             Client[]        @relation("ClientMerge")
  contacts               Contact[]
  communications         Communication[]

  @@index([companyId])
  @@index([status])
  @@map("clients")
}

model Contact {
  id              String      @id @default(cuid()) @db.VarChar(30)
  clientId        String      @map("client_id") @db.VarChar(30)
  name            String      @db.VarChar(150)
  email           String?     @db.Citext
  phone           String?     @db.VarChar(30)
  role            ContactRole @default(PRIMARY)
  isPrimary       Boolean     @default(false) @map("is_primary")
  isBilling       Boolean     @default(false) @map("is_billing")
  canAccessPortal Boolean     @default(true) @map("can_access_portal")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("contacts")
}

model Project {
  id                   String           @id @default(cuid()) @db.VarChar(30)
  companyId            String           @map("company_id") @db.VarChar(30)
  clientId             String           @map("client_id") @db.VarChar(30)
  code                 String           @unique @db.VarChar(30)
  name                 String           @db.VarChar(200)
  ownerUserId          String?          @map("owner_user_id") @db.VarChar(30)
  lifecycleStatus      ProjectLifecycle @default(ENQUIRY) @map("lifecycle_status")
  statusLabelId        String?          @map("status_label_id") @db.VarChar(60)
  commercialStatus     CommercialStatus @default(UNQUOTED) @map("commercial_status")
  source               String?          @db.VarChar(50)
  sourceDetail         String?          @map("source_detail") @db.VarChar(255)
  packageId            String?          @map("package_id") @db.VarChar(30)
  packagePriceSnapshot Decimal?         @map("package_price_snapshot") @db.Decimal(12, 2)
  confirmToken         String?          @unique @map("confirm_token") @db.VarChar(64)
  confirmedByClientAt  DateTime?        @map("confirmed_by_client_at") @db.Timestamptz
  lostReason           DeclineReason?   @map("lost_reason")
  lostAt               DateTime?        @map("lost_at") @db.Timestamptz
  enquiryReceivedAt    DateTime         @default(now()) @map("enquiry_received_at") @db.Timestamptz
  enquiryNotes         String?          @map("enquiry_notes") @db.Text
  firstRespondedAt     DateTime?        @map("first_responded_at") @db.Timestamptz
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt           DateTime?        @map("archived_at") @db.Timestamptz

  company                Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  client                 Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  owner                  User?           @relation("ProjectOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  package                Package?        @relation(fields: [packageId], references: [id], onDelete: SetNull)
  quotes                 Quote[]
  contracts              Contract[]
  bookings               Booking[]
  workItems              WorkItem[]
  invoices               Invoice[]
  payments               Payment[]
  galleries              Gallery[]
  convertedFromEnquiries Enquiry[]       @relation("EnquiryConvertedProject")
  communications         Communication[]
  files                  File[]
  questionnaires         Questionnaire[]
  changeRequests         ChangeRequest[]

  @@index([companyId])
  @@index([clientId])
  @@index([lifecycleStatus])
  @@index([enquiryReceivedAt])
  @@map("projects")
}

model Package {
  id               String   @id @default(cuid()) @db.VarChar(30)
  companyId        String   @map("company_id") @db.VarChar(30)
  name             String   @db.VarChar(150)
  description      String?  @db.Text
  inclusions       String?  @db.Text
  durationHours    Int?     @map("duration_hours")
  basePriceInclGst Decimal  @default(0) @map("base_price_incl_gst") @db.Decimal(12, 2)
  active           Boolean  @default(true)
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  projects Project[]

  @@index([companyId, active])
  @@map("packages")
}

model Enquiry {
  id                 String        @id @default(cuid()) @db.VarChar(30)
  companyId          String        @map("company_id") @db.VarChar(30)
  ownerUserId        String?       @map("owner_user_id") @db.VarChar(30)
  name               String        @db.VarChar(150)
  firstName          String?       @map("first_name") @db.VarChar(80)
  lastName           String?       @map("last_name") @db.VarChar(80)
  email              String        @db.Citext
  phone              String?       @db.VarChar(30)
  street             String?       @db.VarChar(200)
  suburb             String?       @db.VarChar(100)
  state              String?       @db.VarChar(100)
  postcode           String?       @db.VarChar(20)
  country            String?       @db.VarChar(100)
  isCompany          Boolean       @default(false) @map("is_company")
  eventType          String?       @map("event_type") @db.VarChar(50)
  eventDate          DateTime?     @map("event_date") @db.Date
  message            String?       @db.Text
  source             EnquirySource @default(WEBSITE)
  status             EnquiryStatus @default(NEW)
  waitingOn          WaitingOn?    @map("waiting_on")
  lostReason         String?       @map("lost_reason") @db.VarChar(500)
  convertedClientId  String?       @map("converted_client_id") @db.VarChar(30)
  convertedProjectId String?       @map("converted_project_id") @db.VarChar(30)
  convertedAt        DateTime?     @map("converted_at") @db.Timestamptz
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company          Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  owner            User?    @relation("EnquiryOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  convertedClient  Client?  @relation("EnquiryConvertedClient", fields: [convertedClientId], references: [id], onDelete: SetNull)
  convertedProject Project? @relation("EnquiryConvertedProject", fields: [convertedProjectId], references: [id], onDelete: SetNull)
  communications   Communication[]
  workItems        WorkItem[]

  @@index([companyId])
  @@index([status])
  @@index([email])
  @@map("enquiries")
}

model Quote {
  id               String      @id @default(cuid()) @db.VarChar(30)
  projectId        String      @map("project_id") @db.VarChar(30)
  viewToken        String      @unique @map("view_token") @db.VarChar(64)
  status           QuoteStatus @default(DRAFT)
  currentVersionId String?     @unique @map("current_version_id") @db.VarChar(30)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  project        Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  currentVersion QuoteVersion?  @relation("QuoteCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       QuoteVersion[] @relation("QuoteVersions")

  @@index([projectId])
  @@map("quotes")
}

model QuoteVersion {
  id                   String         @id @default(cuid()) @db.VarChar(30)
  quoteId              String         @map("quote_id") @db.VarChar(30)
  versionNumber        Int            @map("version_number")
  status               QuoteStatus    @default(DRAFT)
  currency             String         @default("AUD") @db.VarChar(3)
  subtotal             Decimal        @default(0) @db.Decimal(12, 2)
  discountTotal        Decimal        @default(0) @map("discount_total") @db.Decimal(12, 2)
  taxTotal             Decimal        @default(0) @map("tax_total") @db.Decimal(12, 2)
  total                Decimal        @default(0) @db.Decimal(12, 2)
  validUntil           DateTime?      @map("valid_until") @db.Timestamptz
  createdByUserId      String?        @map("created_by_user_id") @db.VarChar(30)
  sentToClientAt       DateTime?      @map("sent_to_client_at") @db.Timestamptz
  viewedByClientAt     DateTime?      @map("viewed_by_client_at") @db.Timestamptz
  acceptedByClientAt   DateTime?      @map("accepted_by_client_at") @db.Timestamptz
  acceptedByClientName String?        @map("accepted_by_client_name") @db.VarChar(150)
  acceptedByClientIp   String?        @map("accepted_by_client_ip") @db.VarChar(45)
  declineReason        DeclineReason? @map("decline_reason")
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  quote          Quote           @relation("QuoteVersions", fields: [quoteId], references: [id], onDelete: Cascade)
  createdBy      User?           @relation("QuoteVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  currentOf      Quote?          @relation("QuoteCurrentVersion")
  lines          QuoteLine[]
  changeRequests ChangeRequest[]

  @@unique([quoteId, versionNumber])
  @@index([quoteId])
  @@index([status])
  @@map("quote_versions")
}

model QuoteLine {
  id             String   @id @default(cuid()) @db.VarChar(30)
  quoteVersionId String   @map("quote_version_id") @db.VarChar(30)
  lineType       String   @default("custom") @map("line_type") @db.VarChar(30)
  referenceId    String?  @map("reference_id") @db.VarChar(30)
  description    String   @db.VarChar(500)
  quantity       Int      @default(1)
  unitPrice      Decimal  @default(0) @map("unit_price") @db.Decimal(12, 2)
  discount       Decimal  @default(0) @db.Decimal(12, 2)
  tax            Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal  @default(0) @map("line_total") @db.Decimal(12, 2)
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  quoteVersion QuoteVersion @relation(fields: [quoteVersionId], references: [id], onDelete: Cascade)

  @@index([quoteVersionId])
  @@map("quote_lines")
}

model Contract {
  id               String         @id @default(cuid()) @db.VarChar(30)
  projectId        String         @map("project_id") @db.VarChar(30)
  signToken        String         @unique @map("sign_token") @db.VarChar(64)
  status           ContractStatus @default(DRAFT)
  currentVersionId String?        @unique @map("current_version_id") @db.VarChar(30)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  project        Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  currentVersion ContractVersion?  @relation("ContractCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       ContractVersion[] @relation("ContractVersions")

  @@index([projectId])
  @@map("contracts")
}

model ContractVersion {
  id                 String         @id @default(cuid()) @db.VarChar(30)
  contractId         String         @map("contract_id") @db.VarChar(30)
  versionNumber      Int            @map("version_number")
  status             ContractStatus @default(DRAFT)
  documentReference  String?        @map("document_reference") @db.VarChar(255)
  termsSnapshot      Json           @map("terms_snapshot")
  contentHash        String?        @map("content_hash") @db.VarChar(64)
  createdByUserId    String?        @map("created_by_user_id") @db.VarChar(30)
  signedByClientName String?        @map("signed_by_client_name") @db.VarChar(150)
  signedByClientAt   DateTime?      @map("signed_by_client_at") @db.Timestamptz
  signedByClientIp   String?        @map("signed_by_client_ip") @db.VarChar(45)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  contract  Contract  @relation("ContractVersions", fields: [contractId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("ContractVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  currentOf Contract? @relation("ContractCurrentVersion")

  @@unique([contractId, versionNumber])
  @@index([contractId])
  @@index([status])
  @@map("contract_versions")
}

model Booking {
  id                String        @id @default(cuid()) @db.VarChar(30)
  companyId         String        @map("company_id") @db.VarChar(30)
  projectId         String        @map("project_id") @db.VarChar(30)
  title             String?       @db.VarChar(200)
  status            BookingStatus @default(TENTATIVE)
  startsAt          DateTime      @map("starts_at") @db.Timestamptz
  endsAt            DateTime      @map("ends_at") @db.Timestamptz
  timezone          String        @default("Australia/Sydney") @db.VarChar(50)
  location          String?       @db.VarChar(255)
  notes             String?       @db.Text
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  cancelledAt       DateTime?     @map("cancelled_at") @db.Timestamptz
  rescheduledFromId String?       @map("rescheduled_from_id") @db.VarChar(30)

  company         Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project         Project              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  assignments     ResourceAssignment[]
  rescheduledFrom Booking?             @relation("BookingReschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo   Booking[]            @relation("BookingReschedule")

  @@index([projectId])
  @@index([status])
  @@index([startsAt])
  @@map("bookings")
}

model Resource {
  id           String       @id @default(cuid()) @db.VarChar(30)
  companyId    String       @map("company_id") @db.VarChar(30)
  resourceType ResourceType @map("resource_type")
  name         String       @db.VarChar(150)
  linkedUserId String?      @map("linked_user_id") @db.VarChar(30)
  status       String       @default("active") @db.VarChar(30)
  metadata     Json?
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  linkedUser  User?                @relation("ResourceUser", fields: [linkedUserId], references: [id], onDelete: SetNull)
  assignments ResourceAssignment[]

  @@index([companyId, resourceType])
  @@map("resources")
}

model ResourceAssignment {
  id               String           @id @default(cuid()) @db.VarChar(30)
  bookingId        String           @map("booking_id") @db.VarChar(30)
  resourceId       String           @map("resource_id") @db.VarChar(30)
  role             String?          @db.VarChar(50)
  startsAt         DateTime         @map("starts_at") @db.Timestamptz
  endsAt           DateTime         @map("ends_at") @db.Timestamptz
  status           AssignmentStatus @default(ACTIVE)
  assignedByUserId String?          @map("assigned_by_user_id") @db.VarChar(30)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  assignedBy User?    @relation("AssignmentAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@index([resourceId])
  @@index([bookingId])
  @@map("resource_assignments")
}

model Invoice {
  id                   String        @id @default(cuid()) @db.VarChar(30)
  projectId            String        @map("project_id") @db.VarChar(30)
  invoiceNumber        String        @unique @map("invoice_number") @db.VarChar(30)
  type                 InvoiceType
  status               InvoiceStatus @default(DRAFT)
  currency             String        @default("AUD") @db.VarChar(3)
  subtotal             Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal             Decimal       @default(0) @map("tax_total") @db.Decimal(12, 2)
  total                Decimal       @default(0) @db.Decimal(12, 2)
  amountPaid           Decimal       @default(0) @map("amount_paid") @db.Decimal(12, 2)
  dueAt                DateTime?     @map("due_at") @db.Timestamptz
  issuedAt             DateTime?     @map("issued_at") @db.Timestamptz
  billingNameSnapshot  String        @map("billing_name_snapshot") @db.VarChar(150)
  billingEmailSnapshot String?       @map("billing_email_snapshot") @db.VarChar(255)
  voidedAt             DateTime?     @map("voided_at") @db.Timestamptz
  voidReason           String?       @map("void_reason") @db.VarChar(500)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  lines    InvoiceLine[]
  payments Payment[]

  @@index([projectId])
  @@index([status])
  @@index([dueAt])
  @@map("invoices")
}

model InvoiceLine {
  id          String   @id @default(cuid()) @db.VarChar(30)
  invoiceId   String   @map("invoice_id") @db.VarChar(30)
  description String   @db.VarChar(500)
  quantity    Int      @default(1)
  unitPrice   Decimal  @default(0) @map("unit_price") @db.Decimal(12, 2)
  tax         Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal   Decimal  @default(0) @map("line_total") @db.Decimal(12, 2)
  sortOrder   Int      @default(0) @map("sort_order")
  source      String?  @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_lines")
}

model Payment {
  id               String        @id @default(cuid()) @db.VarChar(30)
  invoiceId        String        @map("invoice_id") @db.VarChar(30)
  projectId        String        @map("project_id") @db.VarChar(30)
  status           PaymentStatus @default(PENDING)
  amount           Decimal       @db.Decimal(12, 2)
  currency         String        @default("AUD") @db.VarChar(3)
  paymentMethod    PaymentMethod @map("payment_method")
  receivedAt       DateTime?     @map("received_at") @db.Timestamptz
  recordedByUserId String?       @map("recorded_by_user_id") @db.VarChar(30)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  invoice      Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  project      Project              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  recordedBy   User?                @relation("PaymentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  transactions PaymentTransaction[]
  refunds      Refund[]

  @@index([invoiceId])
  @@index([projectId])
  @@map("payments")
}

model PaymentTransaction {
  id                    String            @id @default(cuid()) @db.VarChar(30)
  paymentId             String            @map("payment_id") @db.VarChar(30)
  provider              String            @default("manual") @db.VarChar(30)
  externalTransactionId String?           @map("external_transaction_id") @db.VarChar(100)
  type                  TransactionType
  amount                Decimal           @db.Decimal(12, 2)
  currency              String            @default("AUD") @db.VarChar(3)
  status                TransactionStatus @default(SUCCEEDED)
  processedAt           DateTime?         @map("processed_at") @db.Timestamptz
  metadata              Json?
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@map("payment_transactions")
}

