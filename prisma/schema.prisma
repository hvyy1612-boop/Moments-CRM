
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [citext]
}

enum UserRole {
  ADMIN
  STUDIO
  EDITOR
}

enum SecurityOutcome {
  SUCCESS
  FAILURE
}

enum ClientType {
  INDIVIDUAL
  BUSINESS
}

enum ClientStatus {
  PROSPECT
  ACTIVE
  ARCHIVED
}

enum ProjectLifecycle {
  ENQUIRY
  QUALIFYING
  QUOTING
  AWAITING_DECISION
  CONFIRMED
  IN_PRODUCTION
  COMPLETED
  CANCELLED
}

enum CommercialStatus {
  UNQUOTED
  QUOTED
  ACCEPTED
  DEPOSIT_PAID
  PAID
  CANCELLED
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
  SUPERSEDED
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  SUPERSEDED
  VOID
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model Company {
  id        String   @id @default(cuid())
  name      String
  abn       String?
  timezone  String   @default("Australia/Sydney")
  currency  String   @default("AUD")
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz

  users    User[]
  clients  Client[]
  projects Project[]
}

model User {
  id                 String    @id @default(cuid())
  companyId          String
  email              String    @unique @db.Citext
  passwordHash       String
  passwordAlgo       String
  role               UserRole
  name               String
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime? @db.Timestamptz
  failedAttempts     Int       @default(0)
  lockedUntil        DateTime? @db.Timestamptz
  passwordChangedAt  DateTime? @db.Timestamptz
  createdAt          DateTime  @default(now()) @db.Timestamptz
  updatedAt          DateTime  @default(now()) @updatedAt @db.Timestamptz

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  passwordResets PasswordReset[]
  sessions       Session[]
  securityEvents SecurityEvent[]
  auditLogs      AuditLog[]
  ownedProjects  Project[]       @relation("ProjectOwner")
  createdQuoteVersions    QuoteVersion[]    @relation("QuoteVersionCreatedBy")
  createdContractVersions ContractVersion[] @relation("ContractVersionCreatedBy")

  @@index([companyId])
  @@index([role])
}

model PasswordReset {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String
  expiresAt   DateTime  @db.Timestamptz
  usedAt      DateTime? @db.Timestamptz
  requestedIp String
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model Session {
  id                String    @id @default(cuid())
  userId            String
  tokenHash         String
  expiresAt         DateTime  @db.Timestamptz
  absoluteExpiresAt DateTime  @db.Timestamptz
  lastActiveAt      DateTime  @default(now()) @db.Timestamptz
  userAgent         String?
  ipAddress         String?
  revokedAt         DateTime? @db.Timestamptz
  createdAt         DateTime  @default(now()) @db.Timestamptz
  updatedAt         DateTime  @default(now()) @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model SecurityEvent {
  id             String          @id @default(cuid())
  eventType      String
  userId         String?
  emailAttempted String?         @db.Citext
  ipAddress      String
  userAgent      String?
  outcome        SecurityOutcome
  createdAt      DateTime        @default(now()) @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
}

model Client {
  id               String       @id @default(cuid())
  companyId        String
  type             ClientType   @default(INDIVIDUAL)
  status           ClientStatus @default(PROSPECT)
  displayName      String
  legalName        String?
  email            String       @unique @db.Citext
  phone            String?
  suburb           String?
  state            String?
  postcode         String?
  marketingConsent Boolean      @default(false)
  consentUpdatedAt DateTime?    @db.Timestamptz
  anonymisedAt     DateTime?    @db.Timestamptz
  notes            String?
  createdAt        DateTime     @default(now()) @db.Timestamptz
  updatedAt        DateTime     @default(now()) @updatedAt @db.Timestamptz
  archivedAt       DateTime?    @db.Timestamptz

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  projects Project[]

  @@index([companyId])
  @@index([status])
}

model Project {
  id               String           @id @default(cuid())
  companyId        String
  clientId         String
  code             String           @unique
  name             String
  ownerUserId      String?
  lifecycleStatus  ProjectLifecycle @default(ENQUIRY)
  commercialStatus CommercialStatus @default(UNQUOTED)
  source           String?
  sourceDetail     String?
  enquiryReceivedAt DateTime        @default(now()) @db.Timestamptz
  enquiryNotes     String?
  firstRespondedAt DateTime?        @db.Timestamptz
  createdAt        DateTime         @default(now()) @db.Timestamptz
  updatedAt        DateTime         @default(now()) @updatedAt @db.Timestamptz
  archivedAt       DateTime?        @db.Timestamptz

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  client    Client     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  owner     User?      @relation("ProjectOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  quotes    Quote[]
  contracts Contract[]

  @@index([companyId])
  @@index([clientId])
  @@index([lifecycleStatus])
  @@index([enquiryReceivedAt])
}

model Quote {
  id               String   @id @default(cuid())
  projectId        String
  viewToken        String   @unique
  status           QuoteStatus @default(DRAFT)
  currentVersionId String?  @unique
  createdAt        DateTime @default(now()) @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @db.Timestamptz

  project        Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  currentVersion QuoteVersion?  @relation("QuoteCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       QuoteVersion[] @relation("QuoteVersions")

  @@index([projectId])
}

model QuoteVersion {
  id            String      @id @default(cuid())
  quoteId       String
  versionNumber Int
  status        QuoteStatus @default(DRAFT)
  currency      String      @default("AUD")
  subtotal      Decimal     @default(0) @db.Decimal(12, 2)
  discountTotal Decimal     @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal     @default(0) @db.Decimal(12, 2)
  total         Decimal     @default(0) @db.Decimal(12, 2)
  validUntil    DateTime?   @db.Timestamptz
  createdById   String?
  sentAt        DateTime?   @db.Timestamptz
  viewedAt      DateTime?   @db.Timestamptz
  acceptedAt    DateTime?   @db.Timestamptz
  acceptedName  String?
  acceptedIp    String?
  createdAt     DateTime    @default(now()) @db.Timestamptz
  updatedAt     DateTime    @default(now()) @updatedAt @db.Timestamptz

  quote     Quote       @relation("QuoteVersions", fields: [quoteId], references: [id], onDelete: Cascade)
  createdBy User?       @relation("QuoteVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  currentOf Quote?      @relation("QuoteCurrentVersion")
  lines     QuoteLine[]

  @@unique([quoteId, versionNumber])
  @@index([quoteId])
  @@index([status])
}

model QuoteLine {
  id             String  @id @default(cuid())
  quoteVersionId String
  lineType       String  @default("custom")
  referenceId    String?
  description    String
  quantity       Int     @default(1)
  unitPrice      Decimal @default(0) @db.Decimal(12, 2)
  discount       Decimal @default(0) @db.Decimal(12, 2)
  tax            Decimal @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal @default(0) @db.Decimal(12, 2)
  sortOrder      Int     @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz

  quoteVersion QuoteVersion @relation(fields: [quoteVersionId], references: [id], onDelete: Cascade)

  @@index([quoteVersionId])
}

model Contract {
  id               String         @id @default(cuid())
  projectId        String
  signToken        String         @unique
  status           ContractStatus @default(DRAFT)
  currentVersionId String?        @unique
  createdAt        DateTime       @default(now()) @db.Timestamptz
  updatedAt        DateTime       @default(now()) @updatedAt @db.Timestamptz

  project        Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  currentVersion ContractVersion?  @relation("ContractCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       ContractVersion[] @relation("ContractVersions")

  @@index([projectId])
}

model ContractVersion {
  id                String         @id @default(cuid())
  contractId        String
  versionNumber     Int
  status            ContractStatus @default(DRAFT)
  documentReference String?
  termsSnapshot     Json
  contentHash       String?
  createdById       String?
  signedName        String?
  signedAt          DateTime?      @db.Timestamptz
  signedIp          String?
  createdAt         DateTime       @default(now()) @db.Timestamptz
  updatedAt         DateTime       @default(now()) @updatedAt @db.Timestamptz

  contract  Contract  @relation("ContractVersions", fields: [contractId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("ContractVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  currentOf Contract? @relation("ContractCurrentVersion")

  @@unique([contractId, versionNumber])
  @@index([contractId])
  @@index([status])
}

model AuditLog {
  id          String   @id @default(cuid())
  companyId   String?
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  beforeData  Json?
  afterData   Json?
  reason      String?
  source      String?
  metadata    Json?
  createdAt   DateTime @default(now()) @db.Timestamptz

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}

model OutboxEvent {
  id            String       @id @default(cuid())
  eventType     String
  aggregateType String
  aggregateId   String
  correlationId String?
  causationId   String?
  payload       Json
  status        OutboxStatus @default(PENDING)
  attemptCount  Int          @default(0)
  availableAt   DateTime     @default(now()) @db.Timestamptz
  processedAt   DateTime?    @db.Timestamptz
  createdAt     DateTime     @default(now()) @db.Timestamptz

  @@index([status, availableAt])
}
