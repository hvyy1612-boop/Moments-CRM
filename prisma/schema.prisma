
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [citext, btree_gist]
}

enum UserRole {
  ADMIN
  STUDIO
  EDITOR
}

enum SecurityOutcome {
  SUCCESS
  FAILURE
}

enum ClientType {
  INDIVIDUAL
  BUSINESS
}

enum ClientStatus {
  PROSPECT
  ACTIVE
  ARCHIVED
}

enum ProjectLifecycle {
  ENQUIRY
  QUALIFYING
  QUOTING
  AWAITING_DECISION
  CONFIRMED
  IN_PRODUCTION
  COMPLETED
  CANCELLED
}

enum CommercialStatus {
  UNQUOTED
  QUOTED
  ACCEPTED
  DEPOSIT_PAID
  PAID
  CANCELLED
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
  SUPERSEDED
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  SUPERSEDED
  VOID
}

enum BookingStatus {
  TENTATIVE
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ResourceType {
  PHOTOGRAPHER
  VIDEOGRAPHER
  SECOND_SHOOTER
  EDITOR
  STUDIO
  EQUIPMENT
}

enum AssignmentStatus {
  ACTIVE
  CANCELLED
}

enum InvoiceType {
  DEPOSIT
  BALANCE
  SUPPLEMENTARY
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum PaymentStatus {
  UNPAID
  PENDING
  PARTIALLY_PAID
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD
  CASH
  OTHER
}

enum TransactionType {
  CHARGE
  REFUND
  REVERSAL
}

enum TransactionStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum GalleryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model Company {
  id        String   @id @default(cuid())
  name      String
  abn       String?
  timezone  String   @default("Australia/Sydney")
  currency  String   @default("AUD")
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz

  users     User[]
  clients   Client[]
  projects  Project[]
  bookings  Booking[]
  resources Resource[]
}

model User {
  id                 String    @id @default(cuid())
  companyId          String
  email              String    @unique @db.Citext
  passwordHash       String
  passwordAlgo       String
  role               UserRole
  name               String
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime? @db.Timestamptz
  failedAttempts     Int       @default(0)
  lockedUntil        DateTime? @db.Timestamptz
  passwordChangedAt  DateTime? @db.Timestamptz
  createdAt          DateTime  @default(now()) @db.Timestamptz
  updatedAt          DateTime  @default(now()) @updatedAt @db.Timestamptz

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  passwordResets PasswordReset[]
  sessions       Session[]
  securityEvents SecurityEvent[]
  auditLogs      AuditLog[]
  ownedProjects  Project[]       @relation("ProjectOwner")
  createdQuoteVersions    QuoteVersion[]       @relation("QuoteVersionCreatedBy")
  createdContractVersions ContractVersion[]    @relation("ContractVersionCreatedBy")
  linkedResources         Resource[]           @relation("ResourceUser")
  assignmentsMade         ResourceAssignment[] @relation("AssignmentAssignedBy")
  recordedPayments        Payment[]            @relation("PaymentRecordedBy")

  @@index([companyId])
  @@index([role])
}

model PasswordReset {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String
  expiresAt   DateTime  @db.Timestamptz
  usedAt      DateTime? @db.Timestamptz
  requestedIp String
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model Session {
  id                String    @id @default(cuid())
  userId            String
  tokenHash         String
  expiresAt         DateTime  @db.Timestamptz
  absoluteExpiresAt DateTime  @db.Timestamptz
  lastActiveAt      DateTime  @default(now()) @db.Timestamptz
  userAgent         String?
  ipAddress         String?
  revokedAt         DateTime? @db.Timestamptz
  createdAt         DateTime  @default(now()) @db.Timestamptz
  updatedAt         DateTime  @default(now()) @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model SecurityEvent {
  id             String          @id @default(cuid())
  eventType      String
  userId         String?
  emailAttempted String?         @db.Citext
  ipAddress      String
  userAgent      String?
  outcome        SecurityOutcome
  createdAt      DateTime        @default(now()) @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
}

model Client {
  id               String       @id @default(cuid())
  companyId        String
  type             ClientType   @default(INDIVIDUAL)
  status           ClientStatus @default(PROSPECT)
  displayName      String
  legalName        String?
  email            String       @unique @db.Citext
  phone            String?
  suburb           String?
  state            String?
  postcode         String?
  marketingConsent Boolean      @default(false)
  consentUpdatedAt DateTime?    @db.Timestamptz
  anonymisedAt     DateTime?    @db.Timestamptz
  notes            String?
  createdAt        DateTime     @default(now()) @db.Timestamptz
  updatedAt        DateTime     @default(now()) @updatedAt @db.Timestamptz
  archivedAt       DateTime?    @db.Timestamptz

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  projects Project[]

  @@index([companyId])
  @@index([status])
}

model Project {
  id               String           @id @default(cuid())
  companyId        String
  clientId         String
  code             String           @unique
  name             String
  ownerUserId      String?
  lifecycleStatus  ProjectLifecycle @default(ENQUIRY)
  commercialStatus CommercialStatus @default(UNQUOTED)
  source           String?
  sourceDetail     String?
  enquiryReceivedAt DateTime        @default(now()) @db.Timestamptz
  enquiryNotes     String?
  firstRespondedAt DateTime?        @db.Timestamptz
  createdAt        DateTime         @default(now()) @db.Timestamptz
  updatedAt        DateTime         @default(now()) @updatedAt @db.Timestamptz
  archivedAt       DateTime?        @db.Timestamptz

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  client    Client     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  owner     User?      @relation("ProjectOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  quotes    Quote[]
  contracts Contract[]
  bookings  Booking[]
  invoices  Invoice[]
  payments  Payment[]
  galleries Gallery[]

  @@index([companyId])
  @@index([clientId])
  @@index([lifecycleStatus])
  @@index([enquiryReceivedAt])
}

model Quote {
  id               String   @id @default(cuid())
  projectId        String
  viewToken        String   @unique
  status           QuoteStatus @default(DRAFT)
  currentVersionId String?  @unique
  createdAt        DateTime @default(now()) @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @db.Timestamptz

  project        Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  currentVersion QuoteVersion?  @relation("QuoteCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       QuoteVersion[] @relation("QuoteVersions")

  @@index([projectId])
}

model QuoteVersion {
  id            String      @id @default(cuid())
  quoteId       String
  versionNumber Int
  status        QuoteStatus @default(DRAFT)
  currency      String      @default("AUD")
  subtotal      Decimal     @default(0) @db.Decimal(12, 2)
  discountTotal Decimal     @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal     @default(0) @db.Decimal(12, 2)
  total         Decimal     @default(0) @db.Decimal(12, 2)
  validUntil    DateTime?   @db.Timestamptz
  createdById   String?
  sentAt        DateTime?   @db.Timestamptz
  viewedAt      DateTime?   @db.Timestamptz
  acceptedAt    DateTime?   @db.Timestamptz
  acceptedName  String?
  acceptedIp    String?
  createdAt     DateTime    @default(now()) @db.Timestamptz
  updatedAt     DateTime    @default(now()) @updatedAt @db.Timestamptz

  quote     Quote       @relation("QuoteVersions", fields: [quoteId], references: [id], onDelete: Cascade)
  createdBy User?       @relation("QuoteVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  currentOf Quote?      @relation("QuoteCurrentVersion")
  lines     QuoteLine[]

  @@unique([quoteId, versionNumber])
  @@index([quoteId])
  @@index([status])
}

model QuoteLine {
  id             String  @id @default(cuid())
  quoteVersionId String
  lineType       String  @default("custom")
  referenceId    String?
  description    String
  quantity       Int     @default(1)
  unitPrice      Decimal @default(0) @db.Decimal(12, 2)
  discount       Decimal @default(0) @db.Decimal(12, 2)
  tax            Decimal @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal @default(0) @db.Decimal(12, 2)
  sortOrder      Int     @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz

  quoteVersion QuoteVersion @relation(fields: [quoteVersionId], references: [id], onDelete: Cascade)

  @@index([quoteVersionId])
}

model Contract {
  id               String         @id @default(cuid())
  projectId        String
  signToken        String         @unique
  status           ContractStatus @default(DRAFT)
  currentVersionId String?        @unique
  createdAt        DateTime       @default(now()) @db.Timestamptz
  updatedAt        DateTime       @default(now()) @updatedAt @db.Timestamptz

  project        Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  currentVersion ContractVersion?  @relation("ContractCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       ContractVersion[] @relation("ContractVersions")

  @@index([projectId])
}

model ContractVersion {
  id                String         @id @default(cuid())
  contractId        String
  versionNumber     Int
  status            ContractStatus @default(DRAFT)
  documentReference String?
  termsSnapshot     Json
  contentHash       String?
  createdById       String?
  signedName        String?
  signedAt          DateTime?      @db.Timestamptz
  signedIp          String?
  createdAt         DateTime       @default(now()) @db.Timestamptz
  updatedAt         DateTime       @default(now()) @updatedAt @db.Timestamptz

  contract  Contract  @relation("ContractVersions", fields: [contractId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("ContractVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  currentOf Contract? @relation("ContractCurrentVersion")

  @@unique([contractId, versionNumber])
  @@index([contractId])
  @@index([status])
}

model Booking {
  id          String        @id @default(cuid())
  companyId   String
  projectId   String
  title       String?
  status      BookingStatus @default(TENTATIVE)
  startsAt    DateTime      @db.Timestamptz
  endsAt      DateTime      @db.Timestamptz
  timezone    String        @default("Australia/Sydney")
  location    String?
  notes       String?
  createdAt   DateTime      @default(now()) @db.Timestamptz
  updatedAt   DateTime      @default(now()) @updatedAt @db.Timestamptz
  cancelledAt DateTime?     @db.Timestamptz

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project     Project              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  assignments ResourceAssignment[]

  @@index([projectId])
  @@index([status])
  @@index([startsAt])
}

model Resource {
  id           String       @id @default(cuid())
  companyId    String
  resourceType ResourceType
  name         String
  linkedUserId String?
  status       String       @default("active")
  metadata     Json?
  createdAt    DateTime     @default(now()) @db.Timestamptz
  updatedAt    DateTime     @default(now()) @updatedAt @db.Timestamptz

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  linkedUser  User?                @relation("ResourceUser", fields: [linkedUserId], references: [id], onDelete: SetNull)
  assignments ResourceAssignment[]

  @@index([companyId, resourceType])
}

model ResourceAssignment {
  id           String           @id @default(cuid())
  bookingId    String
  resourceId   String
  role         String?
  startsAt     DateTime         @db.Timestamptz
  endsAt       DateTime         @db.Timestamptz
  status       AssignmentStatus @default(ACTIVE)
  assignedById String?
  createdAt    DateTime         @default(now()) @db.Timestamptz
  updatedAt    DateTime         @default(now()) @updatedAt @db.Timestamptz

  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  assignedBy User?    @relation("AssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([resourceId])
  @@index([bookingId])
}

model Invoice {
  id                   String        @id @default(cuid())
  projectId            String
  invoiceNumber        String        @unique
  type                 InvoiceType
  status               InvoiceStatus @default(DRAFT)
  currency             String        @default("AUD")
  subtotal             Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal             Decimal       @default(0) @db.Decimal(12, 2)
  total                Decimal       @default(0) @db.Decimal(12, 2)
  amountPaid           Decimal       @default(0) @db.Decimal(12, 2)
  dueAt                DateTime?     @db.Timestamptz
  issuedAt             DateTime?     @db.Timestamptz
  billingNameSnapshot  String
  billingEmailSnapshot String?
  voidedAt             DateTime?     @db.Timestamptz
  voidReason           String?
  createdAt            DateTime      @default(now()) @db.Timestamptz
  updatedAt            DateTime      @default(now()) @updatedAt @db.Timestamptz

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  lines    InvoiceLine[]
  payments Payment[]

  @@index([projectId])
  @@index([status])
  @@index([dueAt])
}

model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @default(0) @db.Decimal(12, 2)
  tax         Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal   Decimal  @default(0) @db.Decimal(12, 2)
  sortOrder   Int      @default(0)
  source      String?
  createdAt   DateTime @default(now()) @db.Timestamptz

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id               String        @id @default(cuid())
  invoiceId        String
  projectId        String
  status           PaymentStatus @default(PENDING)
  amount           Decimal       @db.Decimal(12, 2)
  currency         String        @default("AUD")
  paymentMethod    PaymentMethod
  receivedAt       DateTime?     @db.Timestamptz
  recordedByUserId String?
  createdAt        DateTime      @default(now()) @db.Timestamptz
  updatedAt        DateTime      @default(now()) @updatedAt @db.Timestamptz

  invoice      Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  project      Project              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  recordedBy   User?                @relation("PaymentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  transactions PaymentTransaction[]

  @@index([invoiceId])
  @@index([projectId])
}

model PaymentTransaction {
  id                    String            @id @default(cuid())
  paymentId             String
  provider              String            @default("manual")
  externalTransactionId String?
  type                  TransactionType
  amount                Decimal           @db.Decimal(12, 2)
  currency              String            @default("AUD")
  status                TransactionStatus @default(SUCCEEDED)
  processedAt           DateTime?         @db.Timestamptz
  metadata              Json?
  createdAt             DateTime          @default(now()) @db.Timestamptz

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
}

model Gallery {
  id          String        @id @default(cuid())
  projectId   String
  title       String
  status      GalleryStatus @default(DRAFT)
  accessToken String        @unique
  publishedAt DateTime?     @db.Timestamptz
  createdAt   DateTime      @default(now()) @db.Timestamptz
  updatedAt   DateTime      @default(now()) @updatedAt @db.Timestamptz

  project Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  items   GalleryItem[]

  @@index([projectId])
}

model GalleryItem {
  id        String   @id @default(cuid())
  galleryId String
  caption   String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz

  gallery Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  @@index([galleryId])
}

model AuditLog {
  id          String   @id @default(cuid())
  companyId   String?
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  beforeData  Json?
  afterData   Json?
  reason      String?
  source      String?
  metadata    Json?
  createdAt   DateTime @default(now()) @db.Timestamptz

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}

model OutboxEvent {
  id            String       @id @default(cuid())
  eventType     String
  aggregateType String
  aggregateId   String
  correlationId String?
  causationId   String?
  payload       Json
  status        OutboxStatus @default(PENDING)
  attemptCount  Int          @default(0)
  availableAt   DateTime     @default(now()) @db.Timestamptz
  processedAt   DateTime?    @db.Timestamptz
  createdAt     DateTime     @default(now()) @db.Timestamptz

  @@index([status, availableAt])
}
