// Moments — Prisma schema. Project-centric (Database Blueprint v2 final).
// Slice 1 subset: Company, auth (User/Session/PasswordReset/SecurityEvent), Client,
// Project, Quote/QuoteVersion/QuoteLine, AuditLog, OutboxEvent.
// Later slices add: contracts, bookings/resources, finance, workflow/work_items,
// production/deliverables/galleries, notifications, policies, change_requests, etc.
//
// Locked decisions: single-tenant (one Company row; company_id là reserved field, không RLS),
// project bắt đầu từ enquiry, không leads, work_items canonical (chưa dựng ở slice 1),
// CUID id, money Decimal, timestamptz. Con số business = TBD (không hard-code).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [citext]
}

// ---------- Enums ----------

enum UserRole {
  ADMIN
  STUDIO
  EDITOR
}

enum SecurityOutcome {
  SUCCESS
  FAILURE
}

enum ClientType {
  INDIVIDUAL
  BUSINESS
}

enum ClientStatus {
  PROSPECT
  ACTIVE
  ARCHIVED
}

// Coarse business stage of a Project (P2: gọn, không nhét scheduling/production vào đây).
enum ProjectLifecycle {
  ENQUIRY
  QUALIFYING
  QUOTING
  AWAITING_DECISION
  CONFIRMED
  IN_PRODUCTION
  COMPLETED
  CANCELLED
}

// Derived dimension. Slice 1 dùng lifecycle + commercial; các chiều khác thêm ở slice sau.
enum CommercialStatus {
  UNQUOTED
  QUOTED
  ACCEPTED
  DEPOSIT_PAID
  PAID
  CANCELLED
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
  SUPERSEDED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

// ---------- Company (single tenant) ----------

model Company {
  id        String   @id @default(cuid())
  name      String
  abn       String? // OQ-007 placeholder cho tới khi xác nhận
  timezone  String   @default("Australia/Sydney")
  currency  String   @default("AUD")
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz

  users    User[]
  clients  Client[]
  projects Project[]
}

// ---------- Identity / auth (giữ nguyên hình dạng để code auth tái dùng) ----------

model User {
  id                 String    @id @default(cuid())
  companyId          String
  email              String    @unique @db.Citext
  passwordHash       String
  passwordAlgo       String
  role               UserRole
  name               String
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime? @db.Timestamptz
  failedAttempts     Int       @default(0)
  lockedUntil        DateTime? @db.Timestamptz
  passwordChangedAt  DateTime? @db.Timestamptz
  createdAt          DateTime  @default(now()) @db.Timestamptz
  updatedAt          DateTime  @default(now()) @updatedAt @db.Timestamptz

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  passwordResets PasswordReset[]
  sessions       Session[]
  securityEvents SecurityEvent[]
  auditLogs      AuditLog[]
  ownedProjects  Project[]       @relation("ProjectOwner")
  createdQuoteVersions QuoteVersion[] @relation("QuoteVersionCreatedBy")

  @@index([companyId])
  @@index([role])
}

model PasswordReset {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String
  expiresAt   DateTime  @db.Timestamptz
  usedAt      DateTime? @db.Timestamptz
  requestedIp String
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model Session {
  id                String    @id @default(cuid())
  userId            String
  tokenHash         String
  expiresAt         DateTime  @db.Timestamptz
  absoluteExpiresAt DateTime  @db.Timestamptz
  lastActiveAt      DateTime  @default(now()) @db.Timestamptz
  userAgent         String?
  ipAddress         String?
  revokedAt         DateTime? @db.Timestamptz
  createdAt         DateTime  @default(now()) @db.Timestamptz
  updatedAt         DateTime  @default(now()) @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model SecurityEvent {
  id             String          @id @default(cuid())
  eventType      String
  userId         String?
  emailAttempted String?         @db.Citext
  ipAddress      String
  userAgent      String?
  outcome        SecurityOutcome
  createdAt      DateTime        @default(now()) @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  // INSERT-ONLY (trigger trong migration).

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
}

// ---------- CRM ----------

model Client {
  id               String       @id @default(cuid())
  companyId        String
  type             ClientType   @default(INDIVIDUAL)
  status           ClientStatus @default(PROSPECT)
  displayName      String
  legalName        String?
  email            String       @unique @db.Citext // dedupe tại enquiry (P1)
  phone            String?
  suburb           String?
  state            String?
  postcode         String?
  marketingConsent Boolean      @default(false)
  consentUpdatedAt DateTime?    @db.Timestamptz
  anonymisedAt     DateTime?    @db.Timestamptz
  notes            String?
  createdAt        DateTime     @default(now()) @db.Timestamptz
  updatedAt        DateTime     @default(now()) @updatedAt @db.Timestamptz
  archivedAt       DateTime?    @db.Timestamptz

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  projects Project[]

  @@index([companyId])
  @@index([status])
}

// ---------- Project (operational case, bắt đầu từ enquiry) ----------

model Project {
  id               String           @id @default(cuid())
  companyId        String
  clientId         String
  code             String           @unique
  name             String
  ownerUserId      String?
  lifecycleStatus  ProjectLifecycle @default(ENQUIRY)
  commercialStatus CommercialStatus @default(UNQUOTED) // derived
  source           String? // nguồn enquiry (I-6 taxonomy, TBD)
  sourceDetail     String?
  enquiryReceivedAt DateTime        @default(now()) @db.Timestamptz
  enquiryNotes     String?
  firstRespondedAt DateTime?        @db.Timestamptz // SLA
  createdAt        DateTime         @default(now()) @db.Timestamptz
  updatedAt        DateTime         @default(now()) @updatedAt @db.Timestamptz
  archivedAt       DateTime?        @db.Timestamptz

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  owner   User?   @relation("ProjectOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  quotes  Quote[]

  @@index([companyId])
  @@index([clientId])
  @@index([lifecycleStatus])
  @@index([enquiryReceivedAt])
}

// ---------- Commercial: Quote ----------

model Quote {
  id               String   @id @default(cuid())
  projectId        String
  viewToken        String   @unique // client xem quote qua link, đọc current version
  status           QuoteStatus @default(DRAFT) // cache của current version
  currentVersionId String?  @unique
  createdAt        DateTime @default(now()) @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @db.Timestamptz

  project        Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  currentVersion QuoteVersion?  @relation("QuoteCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       QuoteVersion[] @relation("QuoteVersions")

  @@index([projectId])
}

model QuoteVersion {
  id            String      @id @default(cuid())
  quoteId       String
  versionNumber Int
  status        QuoteStatus @default(DRAFT)
  currency      String      @default("AUD")
  subtotal      Decimal     @default(0) @db.Decimal(12, 2)
  discountTotal Decimal     @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal     @default(0) @db.Decimal(12, 2)
  total         Decimal     @default(0) @db.Decimal(12, 2)
  validUntil    DateTime?   @db.Timestamptz
  createdById   String?
  sentAt        DateTime?   @db.Timestamptz
  viewedAt      DateTime?   @db.Timestamptz
  acceptedAt    DateTime?   @db.Timestamptz
  acceptedName  String? // tên khách gõ khi accept
  acceptedIp    String?
  createdAt     DateTime    @default(now()) @db.Timestamptz
  updatedAt     DateTime    @default(now()) @updatedAt @db.Timestamptz

  quote     Quote       @relation("QuoteVersions", fields: [quoteId], references: [id], onDelete: Cascade)
  createdBy User?       @relation("QuoteVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  currentOf Quote?      @relation("QuoteCurrentVersion")
  lines     QuoteLine[]
  // Invariant: tối đa một version ACCEPTED / quote (partial unique index trong migration).
  // Accepted version immutable (app + rule).

  @@unique([quoteId, versionNumber])
  @@index([quoteId])
  @@index([status])
}

model QuoteLine {
  id             String  @id @default(cuid())
  quoteVersionId String
  lineType       String  @default("custom") // custom | package | addon (slice 1: custom)
  referenceId    String?
  description    String
  quantity       Int     @default(1)
  unitPrice      Decimal @default(0) @db.Decimal(12, 2)
  discount       Decimal @default(0) @db.Decimal(12, 2)
  tax            Decimal @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal @default(0) @db.Decimal(12, 2)
  sortOrder      Int     @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz

  quoteVersion QuoteVersion @relation(fields: [quoteVersionId], references: [id], onDelete: Cascade)

  @@index([quoteVersionId])
}

// ---------- Governance / Reliability ----------

model AuditLog {
  id          String   @id @default(cuid())
  companyId   String?
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  beforeData  Json?
  afterData   Json?
  reason      String?
  source      String?
  metadata    Json?
  createdAt   DateTime @default(now()) @db.Timestamptz

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  // INSERT-ONLY (trigger trong migration).

  @@index([entityType, entityId])
  @@index([createdAt])
}

model OutboxEvent {
  id            String       @id @default(cuid())
  eventType     String
  aggregateType String
  aggregateId   String
  correlationId String?
  causationId   String?
  payload       Json
  status        OutboxStatus @default(PENDING)
  attemptCount  Int          @default(0)
  availableAt   DateTime     @default(now()) @db.Timestamptz
  processedAt   DateTime?    @db.Timestamptz
  createdAt     DateTime     @default(now()) @db.Timestamptz

  @@index([status, availableAt])
}
