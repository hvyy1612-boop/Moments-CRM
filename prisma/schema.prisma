// Moments — Prisma schema. Project-centric (Database Blueprint v2 final).
// Slices 1-5: Company, auth (User/Session/PasswordReset/SignInLog), Client, Project,
// Quote/QuoteVersion/QuoteLine, Contract/ContractVersion, Booking/Resource/ResourceAssignment,
// Invoice/InvoiceLine/Payment/PaymentTransaction, Gallery/GalleryItem, AuditLog, OutboxEvent.
// Later slices add: workflow/work_items, deliverables/revisions/approvals/assets (object storage),
// notifications, policies, change_requests, refunds, Stripe online payment, etc.
//
// Naming: code = camelCase field + PascalCase model; database = snake_case column + snake_case
// plural table (via @map / @@map). Types are explicit per column (varchar(n) with a sensible
// bound, citext for email, text for free-form notes). See docs/17-data-dictionary.md.
//
// Locked decisions: single-tenant (one Company row; company_id là reserved field, không RLS),
// enquiry (lead) có bảng riêng `enquiries` → convert ra Client + Project (B2), work_items canonical,
// CUID id (varchar 30), money Decimal, timestamptz. Con số business = TBD (không hard-code).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  // btree_gist: cho phép EXCLUDE constraint chống một resource nhận hai assignment chồng giờ.
  extensions = [citext, btree_gist]
}

// ---------- Enums ----------

enum UserRole {
  ADMIN
  STUDIO
  EDITOR
}

enum SecurityOutcome {
  SUCCESS
  FAILURE
}

enum ClientType {
  INDIVIDUAL
  BUSINESS
}

enum ClientStatus {
  PROSPECT
  ACTIVE
  ARCHIVED
}

// Coarse business stage of a Project (P2: gọn, không nhét scheduling/production vào đây).
enum ProjectLifecycle {
  ENQUIRY
  QUALIFYING
  QUOTING
  AWAITING_DECISION
  NEGOTIATION
  BOOKING_REQUESTED
  CONFIRMED
  IN_PRODUCTION
  COMPLETED
  CANCELLED
  LOST
  ON_HOLD
  POSTPONED
  ARCHIVED
}

// Derived dimension. Slice 1 dùng lifecycle + commercial; các chiều khác thêm ở slice sau.
enum CommercialStatus {
  UNQUOTED
  QUOTED
  ACCEPTED
  DEPOSIT_PAID
  PAID
  CANCELLED
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
  SUPERSEDED
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  SUPERSEDED
  VOID
}

enum BookingStatus {
  TENTATIVE
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ResourceType {
  PHOTOGRAPHER
  VIDEOGRAPHER
  SECOND_SHOOTER
  EDITOR
  STUDIO
  EQUIPMENT
}

enum AssignmentStatus {
  ACTIVE
  CANCELLED
}

enum InvoiceType {
  DEPOSIT
  BALANCE
  SUPPLEMENTARY
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum PaymentStatus {
  UNPAID
  PENDING
  PARTIALLY_PAID
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD
  CASH
  OTHER
}

enum TransactionType {
  CHARGE
  REFUND
  REVERSAL
}

enum TransactionStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum GalleryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

// B2: acquisition layer — lead (Enquiry) tách khỏi Client. Xem docs/18-crm-flow-reference.md.
enum EnquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
  ARCHIVED
}

// Operational owner of the next response, kept SEPARATE from the pipeline stage above. STUDIO = the
// lead needs staff attention; CLIENT = the studio has replied and is waiting on the client; NULL for
// closed leads. This is what the Enquiries work queue reads, never inferred from status alone.
enum WaitingOn {
  STUDIO
  CLIENT
}

// A work item is one concrete thing a staff member must do on a case (contract docs/23 §6). It is the
// single task concept - no separate Task/WorkflowTask model.
enum WorkItemStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum EnquirySource {
  WEBSITE
  REFERRAL
  INSTAGRAM
  MANUAL
  OTHER
}

enum ClientSource {
  DIRECT_BOOKING
  ENQUIRY
  REFERRAL
  MANUAL
  OTHER
}

// Lý do khách từ chối báo giá / dự án mất (F-QUOTE-03).
enum DeclineReason {
  PRICE
  DATE_UNAVAILABLE
  CHOSE_ANOTHER
  PACKAGE_UNSUITABLE
  NO_LONGER_NEED
  OTHER
}

// Vai trò liên hệ trong một client (F-CLIENT-02).
enum ContactRole {
  PRIMARY
  PARTNER
  BILLING
  OTHER
}

enum CommunicationType {
  EMAIL
  NOTE
  CLIENT_MESSAGE
  CALL
}

enum ChangeRequestType {
  COMMERCIAL
  OPERATIONAL
  CLIENT_DATA
  PRODUCTION
}

enum ChangeRequestStatus {
  PENDING
  IMPACT_ASSESSMENT
  APPROVED
  REJECTED
  APPLIED
}

enum FileKind {
  CONTRACT
  QUESTIONNAIRE
  RAW
  EDITED
  PROOF
  GALLERY
  INVOICE
  OTHER
}

enum FileVisibility {
  INTERNAL
  CLIENT_VISIBLE
}

enum QuestionnaireStatus {
  PENDING
  COMPLETED
}

// ---------- Company (single tenant) ----------

model Company {
  id        String   @id @default(cuid()) @db.VarChar(30)
  name      String   @db.VarChar(150)
  abn       String?  @db.VarChar(20) // OQ-007 placeholder cho tới khi xác nhận
  timezone  String   @default("Australia/Sydney") @db.VarChar(50)
  currency  String   @default("AUD") @db.VarChar(3)
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  users     User[]
  clients   Client[]
  projects  Project[]
  enquiries Enquiry[]
  packages  Package[]
  bookings  Booking[]
  resources Resource[]
  workItems WorkItem[]
  calendarEvents CalendarEvent[]
  invoiceTemplates InvoiceTemplate[]

  @@map("companies")
}

// ---------- Identity / auth (giữ nguyên hình dạng để code auth tái dùng) ----------

model User {
  id                 String    @id @default(cuid()) @db.VarChar(30)
  companyId          String    @map("company_id") @db.VarChar(30)
  email              String    @unique @db.Citext
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  passwordAlgo       String    @map("password_algo") @db.VarChar(30)
  role               UserRole
  name               String    @db.VarChar(150)
  isActive           Boolean   @default(true) @map("is_active")
  status             String    @default("PENDING") @db.VarChar(20) // PENDING | ACTIVE | REJECTED (self-signup approval)
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz
  failedAttempts     Int       @default(0) @map("failed_attempts")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz
  passwordChangedAt  DateTime? @map("password_changed_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company                 Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  passwordResets          PasswordReset[]
  sessions                Session[]
  signInLogs          SignInLog[]
  auditLogs               AuditLog[]
  ownedProjects           Project[]            @relation("ProjectOwner")
  createdQuoteVersions    QuoteVersion[]       @relation("QuoteVersionCreatedBy")
  createdContractVersions ContractVersion[]    @relation("ContractVersionCreatedBy")
  linkedResources         Resource[]           @relation("ResourceUser")
  assignmentsMade         ResourceAssignment[] @relation("AssignmentAssignedBy")
  recordedPayments        Payment[]            @relation("PaymentRecordedBy")
  ownedEnquiries          Enquiry[]            @relation("EnquiryOwner")
  communications          Communication[]
  uploadedFiles           File[]
  requestedChanges        ChangeRequest[]      @relation("ChangeRequestedBy")
  approvedChanges         ChangeRequest[]      @relation("ChangeApprovedBy")
  completedWorkItems      WorkItem[]           @relation("WorkItemCompletedBy")
  createdCalendarEvents   CalendarEvent[]      @relation("CalendarEventCreatedBy")
  clientNotes             ClientNote[]         @relation("ClientNoteCreatedBy")

  @@index([companyId])
  @@index([role])
  @@map("users")
}

model PasswordReset {
  id          String    @id @default(cuid()) @db.VarChar(30)
  userId      String    @map("user_id") @db.VarChar(30)
  tokenHash   String    @map("token_hash") @db.VarChar(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  usedAt      DateTime? @map("used_at") @db.Timestamptz
  requestedIp String    @map("requested_ip") @db.VarChar(45)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_resets")
}

model Session {
  id                String    @id @default(cuid()) @db.VarChar(30)
  userId            String    @map("user_id") @db.VarChar(30)
  tokenHash         String    @map("token_hash") @db.VarChar(64)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz
  lastActiveAt      DateTime  @default(now()) @map("last_active_at") @db.Timestamptz
  userAgent         String?   @map("user_agent") @db.VarChar(400)
  ipAddress         String?   @map("ip_address") @db.VarChar(45)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("sessions")
}

model SignInLog {
  id             String          @id @default(cuid()) @db.VarChar(30)
  eventType      String          @map("event_type") @db.VarChar(100)
  userId         String?         @map("user_id") @db.VarChar(30)
  emailAttempted String?         @map("email_attempted") @db.Citext
  ipAddress      String          @map("ip_address") @db.VarChar(45)
  userAgent      String?         @map("user_agent") @db.VarChar(400)
  outcome        SecurityOutcome
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  // INSERT-ONLY (trigger trong migration).

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
  @@map("security_events")
}

// ---------- CRM ----------

model Client {
  id                 String       @id @default(cuid()) @db.VarChar(30)
  companyId          String       @map("company_id") @db.VarChar(30)
  type               ClientType   @default(INDIVIDUAL)
  status             ClientStatus @default(PROSPECT)
  source             ClientSource @default(MANUAL) // B2: khách đến từ đâu (dashboard)
  displayName        String       @map("display_name") @db.VarChar(150)
  legalName          String?      @map("legal_name") @db.VarChar(150)
  firstName          String?      @map("first_name") @db.VarChar(80)
  lastName           String?      @map("last_name") @db.VarChar(80)
  email              String       @unique @db.Citext // dedupe tại enquiry (P1)
  phone              String?      @db.VarChar(30)
  street             String?      @db.VarChar(200)
  suburb             String?      @db.VarChar(100)
  state              String?      @db.VarChar(100)
  postcode           String?      @db.VarChar(20)
  country            String?      @db.VarChar(100)
  marketingConsent   Boolean      @default(false) @map("marketing_consent")
  consentUpdatedAt   DateTime?    @map("consent_updated_at") @db.Timestamptz
  anonymisedAt       DateTime?    @map("anonymised_at") @db.Timestamptz
  notes              String?      @db.Text // ghi chú tự do, không giới hạn
  portalToken        String?      @unique @map("portal_token") @db.VarChar(64) // unified client portal link
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt         DateTime?    @map("archived_at") @db.Timestamptz
  mergedIntoClientId String?      @map("merged_into_client_id") @db.VarChar(30) // B2: gộp trùng → bản giữ

  company                Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  projects               Project[]
  convertedFromEnquiries Enquiry[]       @relation("EnquiryConvertedClient")
  mergedInto             Client?         @relation("ClientMerge", fields: [mergedIntoClientId], references: [id], onDelete: SetNull)
  mergedFrom             Client[]        @relation("ClientMerge")
  contacts               Contact[]
  communications         Communication[]
  calendarEvents         CalendarEvent[]
  noteEntries            ClientNote[]

  @@index([companyId])
  @@index([status])
  @@map("clients")
}

// ---------- CRM: Contact (F-CLIENT-02) ----------
// 1 client ↔ nhiều contact (cặp đôi, người ký, billing...). Mỗi client nên có ≥1 contact PRIMARY.
model Contact {
  id              String      @id @default(cuid()) @db.VarChar(30)
  clientId        String      @map("client_id") @db.VarChar(30)
  name            String      @db.VarChar(150)
  email           String?     @db.Citext
  phone           String?     @db.VarChar(30)
  role            ContactRole @default(PRIMARY)
  isPrimary       Boolean     @default(false) @map("is_primary")
  isBilling       Boolean     @default(false) @map("is_billing")
  canAccessPortal Boolean     @default(true) @map("can_access_portal")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("contacts")
}

// ---------- Project (operational case, bắt đầu từ enquiry) ----------

model Project {
  id                   String           @id @default(cuid()) @db.VarChar(30)
  companyId            String           @map("company_id") @db.VarChar(30)
  clientId             String           @map("client_id") @db.VarChar(30)
  code                 String           @unique @db.VarChar(30)
  name                 String           @db.VarChar(200)
  ownerUserId          String?          @map("owner_user_id") @db.VarChar(30)
  lifecycleStatus      ProjectLifecycle @default(ENQUIRY) @map("lifecycle_status")
  // Optional custom status label (company-defined, Monday-style). The lifecycle enum above still
  // drives all automation; this only overrides how the status reads on the board when set.
  statusLabelId        String?          @map("status_label_id") @db.VarChar(60)
  commercialStatus     CommercialStatus @default(UNQUOTED) @map("commercial_status") // derived
  source               String?          @db.VarChar(50) // nguồn enquiry (I-6 taxonomy, TBD)
  sourceDetail         String?          @map("source_detail") @db.VarChar(255)
  packageId            String?          @map("package_id") @db.VarChar(30) // direct booking: gói đã chọn
  packagePriceSnapshot Decimal?         @map("package_price_snapshot") @db.Decimal(12, 2) // giá gói chốt lúc đặt
  confirmToken         String?          @unique @map("confirm_token") @db.VarChar(64) // link khách xác nhận (thay quote/contract)
  confirmedByClientAt  DateTime?        @map("confirmed_by_client_at") @db.Timestamptz
  lostReason           DeclineReason?   @map("lost_reason") // vì sao dự án mất (F-QUOTE-03)
  lostAt               DateTime?        @map("lost_at") @db.Timestamptz
  enquiryReceivedAt    DateTime         @default(now()) @map("enquiry_received_at") @db.Timestamptz
  enquiryNotes         String?          @map("enquiry_notes") @db.Text // ghi chú tự do, không giới hạn
  firstRespondedAt     DateTime?        @map("first_responded_at") @db.Timestamptz // SLA
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt           DateTime?        @map("archived_at") @db.Timestamptz

  company                Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  client                 Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  owner                  User?           @relation("ProjectOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  package                Package?        @relation(fields: [packageId], references: [id], onDelete: SetNull)
  quotes                 Quote[]
  contracts              Contract[]
  bookings               Booking[]
  workItems              WorkItem[]
  invoices               Invoice[]
  payments               Payment[]
  galleries              Gallery[]
  convertedFromEnquiries Enquiry[]       @relation("EnquiryConvertedProject")
  communications         Communication[]
  files                  File[]
  questionnaires         Questionnaire[]
  changeRequests         ChangeRequest[]

  @@index([companyId])
  @@index([clientId])
  @@index([lifecycleStatus])
  @@index([enquiryReceivedAt])
  @@map("projects")
}

// ---------- Commercial: Package (F-PKG, B2) ----------
// Gói dịch vụ giá cố định (GST-inclusive). Direct booking chọn gói → Project snapshot giá. Đổi giá gói
// sau KHÔNG đổi record cũ (pricing history = snapshot trên Project/Quote/Invoice).
model Package {
  id               String   @id @default(cuid()) @db.VarChar(30)
  companyId        String   @map("company_id") @db.VarChar(30)
  name             String   @db.VarChar(150)
  description      String?  @db.Text
  inclusions       String?  @db.Text // mỗi dòng 1 mục
  durationHours    Int?     @map("duration_hours")
  basePriceInclGst Decimal  @default(0) @map("base_price_incl_gst") @db.Decimal(12, 2)
  isAddOn          Boolean  @default(false) @map("is_add_on") // add-on (film, super 8, album) vs base package
  active           Boolean  @default(true)
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  projects Project[]

  @@index([companyId, active])
  @@map("packages")
}

// ---------- Acquisition: Enquiry (lead, B2) ----------
// Khách gửi enquiry chưa cam kết sống ở đây — CHƯA tạo Client/Project. Staff lọc; convert khi khách
// chọn mình → upsert Client theo email + tạo Project, set CONVERTED + link ngược. Không xoá khi LOST;
// email KHÔNG unique (một người có thể hỏi nhiều lần). Xem docs/18-crm-flow-reference.md.
model Enquiry {
  id                 String        @id @default(cuid()) @db.VarChar(30)
  companyId          String        @map("company_id") @db.VarChar(30)
  ownerUserId        String?       @map("owner_user_id") @db.VarChar(30)
  name               String        @db.VarChar(150)
  firstName          String?       @map("first_name") @db.VarChar(80)
  lastName           String?       @map("last_name") @db.VarChar(80)
  email              String        @db.Citext // KHÔNG unique: một người có thể hỏi nhiều lần
  phone              String?       @db.VarChar(30)
  street             String?       @db.VarChar(200)
  suburb             String?       @db.VarChar(100)
  state              String?       @db.VarChar(100)
  postcode           String?       @db.VarChar(20)
  country            String?       @db.VarChar(100)
  isCompany          Boolean       @default(false) @map("is_company")
  eventType          String?       @map("event_type") @db.VarChar(50)
  eventDate          DateTime?     @map("event_date") @db.Date // chỉ ngày, chưa có giờ
  message            String?       @db.Text
  source             EnquirySource @default(WEBSITE)
  status             EnquiryStatus @default(NEW)
  waitingOn          WaitingOn?    @map("waiting_on")
  lostReason         String?       @map("lost_reason") @db.VarChar(500)
  convertedClientId  String?       @map("converted_client_id") @db.VarChar(30)
  convertedProjectId String?       @map("converted_project_id") @db.VarChar(30)
  convertedAt        DateTime?     @map("converted_at") @db.Timestamptz
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company          Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  owner            User?    @relation("EnquiryOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  convertedClient  Client?  @relation("EnquiryConvertedClient", fields: [convertedClientId], references: [id], onDelete: SetNull)
  convertedProject Project? @relation("EnquiryConvertedProject", fields: [convertedProjectId], references: [id], onDelete: SetNull)
  communications   Communication[]
  workItems        WorkItem[]

  @@index([companyId])
  @@index([status])
  @@index([email])
  @@map("enquiries")
}

// ---------- Commercial: Quote ----------

model Quote {
  id               String      @id @default(cuid()) @db.VarChar(30)
  projectId        String      @map("project_id") @db.VarChar(30)
  viewToken        String      @unique @map("view_token") @db.VarChar(64) // client xem quote qua link
  status           QuoteStatus @default(DRAFT) // cache của current version
  currentVersionId String?     @unique @map("current_version_id") @db.VarChar(30)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  project        Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  currentVersion QuoteVersion?  @relation("QuoteCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       QuoteVersion[] @relation("QuoteVersions")

  @@index([projectId])
  @@map("quotes")
}

model QuoteVersion {
  id                   String         @id @default(cuid()) @db.VarChar(30)
  quoteId              String         @map("quote_id") @db.VarChar(30)
  versionNumber        Int            @map("version_number")
  status               QuoteStatus    @default(DRAFT)
  currency             String         @default("AUD") @db.VarChar(3)
  subtotal             Decimal        @default(0) @db.Decimal(12, 2)
  discountTotal        Decimal        @default(0) @map("discount_total") @db.Decimal(12, 2)
  taxTotal             Decimal        @default(0) @map("tax_total") @db.Decimal(12, 2)
  total                Decimal        @default(0) @db.Decimal(12, 2)
  validUntil           DateTime?      @map("valid_until") @db.Timestamptz
  createdByUserId      String?        @map("created_by_user_id") @db.VarChar(30)
  sentToClientAt       DateTime?      @map("sent_to_client_at") @db.Timestamptz
  viewedByClientAt     DateTime?      @map("viewed_by_client_at") @db.Timestamptz
  acceptedByClientAt   DateTime?      @map("accepted_by_client_at") @db.Timestamptz
  acceptedByClientName String?        @map("accepted_by_client_name") @db.VarChar(150) // tên khách gõ khi accept
  acceptedByClientIp   String?        @map("accepted_by_client_ip") @db.VarChar(45)
  declineReason        DeclineReason? @map("decline_reason") // khi version DECLINED (F-QUOTE-03)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  quote          Quote           @relation("QuoteVersions", fields: [quoteId], references: [id], onDelete: Cascade)
  createdBy      User?           @relation("QuoteVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  currentOf      Quote?          @relation("QuoteCurrentVersion")
  lines          QuoteLine[]
  changeRequests ChangeRequest[]
  // Invariant: tối đa một version ACCEPTED / quote (partial unique index trong migration).
  // Accepted version immutable (app + rule).

  @@unique([quoteId, versionNumber])
  @@index([quoteId])
  @@index([status])
  @@map("quote_versions")
}

model QuoteLine {
  id             String   @id @default(cuid()) @db.VarChar(30)
  quoteVersionId String   @map("quote_version_id") @db.VarChar(30)
  lineType       String   @default("custom") @map("line_type") @db.VarChar(30) // custom | package | addon
  referenceId    String?  @map("reference_id") @db.VarChar(30)
  description    String   @db.VarChar(500)
  quantity       Int      @default(1)
  unitPrice      Decimal  @default(0) @map("unit_price") @db.Decimal(12, 2)
  discount       Decimal  @default(0) @db.Decimal(12, 2)
  tax            Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal  @default(0) @map("line_total") @db.Decimal(12, 2)
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  quoteVersion QuoteVersion @relation(fields: [quoteVersionId], references: [id], onDelete: Cascade)

  @@index([quoteVersionId])
  @@map("quote_lines")
}

// ---------- Commercial: Contract ----------
// Sinh từ quote đã ACCEPTED. Client ký qua signToken (không login). Signed version immutable
// (partial unique + trigger trong migration). Amendment = version mới, không sửa bản đã ký.

model Contract {
  id               String         @id @default(cuid()) @db.VarChar(30)
  projectId        String         @map("project_id") @db.VarChar(30)
  signToken        String         @unique @map("sign_token") @db.VarChar(64) // client mở + ký qua link
  status           ContractStatus @default(DRAFT) // cache của current version
  currentVersionId String?        @unique @map("current_version_id") @db.VarChar(30)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  project        Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  currentVersion ContractVersion?  @relation("ContractCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       ContractVersion[] @relation("ContractVersions")

  @@index([projectId])
  @@map("contracts")
}

model ContractVersion {
  id                 String         @id @default(cuid()) @db.VarChar(30)
  contractId         String         @map("contract_id") @db.VarChar(30)
  versionNumber      Int            @map("version_number")
  status             ContractStatus @default(DRAFT)
  documentReference  String?        @map("document_reference") @db.VarChar(255) // link/ref tới bản PDF
  termsSnapshot      Json           @map("terms_snapshot") // ảnh chụp: client, project code, dòng quote + tổng
  contentHash        String?        @map("content_hash") @db.VarChar(64) // hash snapshot chứng minh bản ký không đổi
  createdByUserId    String?        @map("created_by_user_id") @db.VarChar(30)
  signedByClientName String?        @map("signed_by_client_name") @db.VarChar(150) // tên khách gõ khi ký
  signedByClientAt   DateTime?      @map("signed_by_client_at") @db.Timestamptz
  signedByClientIp   String?        @map("signed_by_client_ip") @db.VarChar(45)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  contract  Contract  @relation("ContractVersions", fields: [contractId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("ContractVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  currentOf Contract? @relation("ContractCurrentVersion")
  // Invariant: tối đa một version SIGNED / contract (partial unique index trong migration).
  // Signed version immutable (app + trigger).

  @@unique([contractId, versionNumber])
  @@index([contractId])
  @@index([status])
  @@map("contract_versions")
}

// ---------- Scheduling (Domain 06) ----------
// Một dự án CONFIRMED có thể có nhiều buổi chụp (engagement, ngày cưới...). Mỗi buổi gán ekip/thiết
// bị qua ResourceAssignment; một resource không thể nhận hai assignment ACTIVE chồng thời gian
// (EXCLUDE USING gist trong migration, cần extension btree_gist).

model Booking {
  id                String        @id @default(cuid()) @db.VarChar(30)
  companyId         String        @map("company_id") @db.VarChar(30)
  projectId         String        @map("project_id") @db.VarChar(30)
  title             String?       @db.VarChar(200)
  status            BookingStatus @default(TENTATIVE)
  startsAt          DateTime      @map("starts_at") @db.Timestamptz
  endsAt            DateTime      @map("ends_at") @db.Timestamptz
  timezone          String        @default("Australia/Sydney") @db.VarChar(50)
  location          String?       @db.VarChar(255)
  notes             String?       @db.Text // ghi chú tự do, không giới hạn
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  cancelledAt       DateTime?     @map("cancelled_at") @db.Timestamptz
  rescheduledFromId String?       @map("rescheduled_from_id") @db.VarChar(30)

  company         Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project         Project              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  assignments     ResourceAssignment[]
  rescheduledFrom Booking?             @relation("BookingReschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo   Booking[]            @relation("BookingReschedule")

  @@index([projectId])
  @@index([status])
  @@index([startsAt])
  @@map("bookings")
}

model Resource {
  id           String       @id @default(cuid()) @db.VarChar(30)
  companyId    String       @map("company_id") @db.VarChar(30)
  resourceType ResourceType @map("resource_type")
  name         String       @db.VarChar(150)
  linkedUserId String?      @map("linked_user_id") @db.VarChar(30) // nếu resource là một nhân sự
  status       String       @default("active") @db.VarChar(30)
  metadata     Json?
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  linkedUser  User?                @relation("ResourceUser", fields: [linkedUserId], references: [id], onDelete: SetNull)
  assignments ResourceAssignment[]

  @@index([companyId, resourceType])
  @@map("resources")
}

model ResourceAssignment {
  id               String           @id @default(cuid()) @db.VarChar(30)
  bookingId        String           @map("booking_id") @db.VarChar(30)
  resourceId       String           @map("resource_id") @db.VarChar(30)
  role             String?          @db.VarChar(50)
  startsAt         DateTime         @map("starts_at") @db.Timestamptz // = cửa sổ thời gian của booking
  endsAt           DateTime         @map("ends_at") @db.Timestamptz
  status           AssignmentStatus @default(ACTIVE)
  assignedByUserId String?          @map("assigned_by_user_id") @db.VarChar(30)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  assignedBy User?    @relation("AssignmentAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  // Invariant: một resource không nhận hai assignment ACTIVE chồng thời gian
  // (EXCLUDE USING gist trên (resourceId, tstzrange(startsAt, endsAt)) WHERE status='ACTIVE').

  @@index([resourceId])
  @@index([bookingId])
  @@map("resource_assignments")
}

// ---------- Finance (Domain 05) ----------
// Hoá đơn xuất từ dự án CONFIRMED. amount_paid là cache; nguồn sự thật là PaymentTransaction
// (append-only). Void thay vì xoá. Billing snapshot giữ tính toàn vẹn hoá đơn thuế theo thời điểm.
// Stripe online để sau (env flag); slice này ghi nhận thanh toán thủ công (provider = manual).

model Invoice {
  id                   String        @id @default(cuid()) @db.VarChar(30)
  projectId            String        @map("project_id") @db.VarChar(30)
  invoiceNumber        String        @unique @map("invoice_number") @db.VarChar(30)
  type                 InvoiceType
  status               InvoiceStatus @default(DRAFT)
  currency             String        @default("AUD") @db.VarChar(3)
  subtotal             Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal             Decimal       @default(0) @map("tax_total") @db.Decimal(12, 2)
  total                Decimal       @default(0) @db.Decimal(12, 2)
  amountPaid           Decimal       @default(0) @map("amount_paid") @db.Decimal(12, 2) // cache; nguồn = transactions
  dueAt                DateTime?     @map("due_at") @db.Timestamptz
  issuedAt             DateTime?     @map("issued_at") @db.Timestamptz
  billingNameSnapshot  String        @map("billing_name_snapshot") @db.VarChar(150)
  billingEmailSnapshot String?       @map("billing_email_snapshot") @db.VarChar(255)
  voidedAt             DateTime?     @map("voided_at") @db.Timestamptz
  voidReason           String?       @map("void_reason") @db.VarChar(500)
  invoiceDate          DateTime?     @map("invoice_date") @db.Timestamptz // document date shown on the invoice
  poNumber             String?       @map("po_number") @db.VarChar(60)
  notes                String?       @db.Text // free-text notes printed on the invoice
  accessToken          String?       @unique @map("access_token") @db.VarChar(64) // client portal link
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  lines       InvoiceLine[]
  payments    Payment[]
  instalments InvoiceInstalment[]

  @@index([projectId])
  @@index([status])
  @@index([dueAt])
  @@map("invoices")
}

/// A scheduled payment instalment on an invoice (Studio-Ninja "payment schedule"). The instalments
/// sum to the invoice total; recorded Payments pay them down. Status is UNPAID | PAID (cache).
model InvoiceInstalment {
  id        String    @id @default(cuid()) @db.VarChar(30)
  invoiceId String    @map("invoice_id") @db.VarChar(30)
  label     String?   @db.VarChar(100)
  dueAt     DateTime? @map("due_at") @db.Timestamptz
  amount    Decimal   @default(0) @db.Decimal(12, 2)
  status    String    @default("UNPAID") @db.VarChar(20)
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_instalments")
}

/// A reusable set of invoice line items saved by the studio (Studio-Ninja "invoice template").
/// A titled note on a client (Studio-Ninja "Client Notes" - a running list, not one field).
model ClientNote {
  id              String   @id @default(cuid()) @db.VarChar(30)
  clientId        String   @map("client_id") @db.VarChar(30)
  title           String?  @db.VarChar(150)
  body            String   @db.Text
  createdByUserId String?  @map("created_by_user_id") @db.VarChar(30)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("ClientNoteCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@map("client_notes")
}

model InvoiceTemplate {
  id        String   @id @default(cuid()) @db.VarChar(30)
  companyId String   @map("company_id") @db.VarChar(30)
  name      String   @db.VarChar(150)
  linesJson String   @map("lines_json") @db.Text // JSON: [{description, quantity, unitPrice}]
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("invoice_templates")
}

model InvoiceLine {
  id          String   @id @default(cuid()) @db.VarChar(30)
  invoiceId   String   @map("invoice_id") @db.VarChar(30)
  itemName    String?  @map("item_name") @db.VarChar(200) // product/package name (bold heading); description holds the detail
  description String   @db.VarChar(500)
  quantity    Int      @default(1)
  unitPrice   Decimal  @default(0) @map("unit_price") @db.Decimal(12, 2)
  discount    Decimal  @default(0) @db.Decimal(12, 2) // amount off this line
  tax         Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal   Decimal  @default(0) @map("line_total") @db.Decimal(12, 2)
  sortOrder   Int      @default(0) @map("sort_order")
  source      String?  @db.VarChar(50) // vd add_on, extra_revision
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_lines")
}

model Payment {
  id               String        @id @default(cuid()) @db.VarChar(30)
  invoiceId        String        @map("invoice_id") @db.VarChar(30)
  projectId        String        @map("project_id") @db.VarChar(30)
  status           PaymentStatus @default(PENDING) // derived từ transactions
  amount           Decimal       @db.Decimal(12, 2)
  currency         String        @default("AUD") @db.VarChar(3)
  paymentMethod    PaymentMethod @map("payment_method")
  receivedAt       DateTime?     @map("received_at") @db.Timestamptz
  recordedByUserId String?       @map("recorded_by_user_id") @db.VarChar(30) // null nếu do gateway
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  invoice      Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  project      Project              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  recordedBy   User?                @relation("PaymentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  transactions PaymentTransaction[]
  refunds      Refund[]

  @@index([invoiceId])
  @@index([projectId])
  @@map("payments")
}

model PaymentTransaction {
  id                    String            @id @default(cuid()) @db.VarChar(30)
  paymentId             String            @map("payment_id") @db.VarChar(30)
  provider              String            @default("manual") @db.VarChar(30)
  externalTransactionId String?           @map("external_transaction_id") @db.VarChar(100) // id từ gateway
  type                  TransactionType
  amount                Decimal           @db.Decimal(12, 2)
  currency              String            @default("AUD") @db.VarChar(3)
  status                TransactionStatus @default(SUCCEEDED)
  processedAt           DateTime?         @map("processed_at") @db.Timestamptz
  metadata              Json?
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  // APPEND-ONLY (trigger). uq(provider, externalTransactionId) khi external id có giá trị (idempotency).

  @@index([paymentId])
  @@map("payment_transactions")
}

// ---------- Production / Delivery (Domain 08) ----------
// Slice 5 subset: giao khách qua Gallery. Client mở gallery bằng accessToken (không login). Publish
// gallery = đã giao → dự án COMPLETED. Asset/object storage, revisions, approvals để dành slice sau;
// item hiện lưu URL ngoài (studio host ảnh ở nơi khác) thay vì tự lưu file.

model Gallery {
  id          String        @id @default(cuid()) @db.VarChar(30)
  projectId   String        @map("project_id") @db.VarChar(30)
  title       String        @db.VarChar(200)
  status      GalleryStatus @default(DRAFT)
  accessToken String        @unique @map("access_token") @db.VarChar(64) // client xem gallery qua link
  publishedAt DateTime?     @map("published_at") @db.Timestamptz
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  project Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  items   GalleryItem[]

  @@index([projectId])
  @@map("galleries")
}

model GalleryItem {
  id        String   @id @default(cuid()) @db.VarChar(30)
  galleryId String   @map("gallery_id") @db.VarChar(30)
  caption   String   @db.VarChar(255)
  url       String   @db.VarChar(2048) // link http/https tới ảnh/tài nguyên (validate ở app)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  gallery Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  @@index([galleryId])
  @@map("gallery_items")
}

// ---------- Governance / Reliability ----------

model AuditLog {
  id          String   @id @default(cuid()) @db.VarChar(30)
  companyId   String?  @map("company_id") @db.VarChar(30)
  actorUserId String?  @map("actor_user_id") @db.VarChar(30)
  action      String   @db.VarChar(100)
  entityType  String   @map("entity_type") @db.VarChar(50)
  entityId    String   @map("entity_id") @db.VarChar(30)
  beforeData  Json?    @map("before_data")
  afterData   Json?    @map("after_data")
  reason      String?  @db.VarChar(500)
  source      String?  @db.VarChar(50)
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  // INSERT-ONLY (trigger trong migration).

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model OutboxEvent {
  id            String       @id @default(cuid()) @db.VarChar(30)
  eventType     String       @map("event_type") @db.VarChar(100)
  aggregateType String       @map("aggregate_type") @db.VarChar(50)
  aggregateId   String       @map("aggregate_id") @db.VarChar(30)
  correlationId String?      @map("correlation_id") @db.VarChar(30)
  causationId   String?      @map("causation_id") @db.VarChar(30)
  payload       Json
  status        OutboxStatus @default(PENDING)
  attemptCount  Int          @default(0) @map("attempt_count")
  availableAt   DateTime     @default(now()) @map("available_at") @db.Timestamptz
  processedAt   DateTime?    @map("processed_at") @db.Timestamptz
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz

  @@index([status, availableAt])
  @@map("outbox_events")
}

// ---------- Backlog: collaboration, changes, finance edges (docs/16 E-J) ----------

// What has been exchanged with the client on a project (call, email, note, message from the portal).
model Communication {
  id        String            @id @default(cuid()) @db.VarChar(30)
  projectId String?           @map("project_id") @db.VarChar(30)
  enquiryId String?           @map("enquiry_id") @db.VarChar(30)
  clientId  String?           @map("client_id") @db.VarChar(30)
  type      CommunicationType
  direction String            @db.VarChar(10) // inbound | outbound
  subject   String?           @db.VarChar(255)
  body      String            @db.Text
  byUserId  String?           @map("by_user_id") @db.VarChar(30) // null khi do client/hệ thống
  channel   String?           @db.VarChar(50)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client  Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  by      User?   @relation(fields: [byUserId], references: [id], onDelete: SetNull)
  enquiry Enquiry? @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([enquiryId, createdAt])
  @@map("communications")
}

// Single task concept for a case's workflow (contract docs/23). Attached to an enquiry or a project.
model WorkItem {
  id                String         @id @default(cuid()) @db.VarChar(30)
  companyId         String         @map("company_id") @db.VarChar(30)
  enquiryId         String?        @map("enquiry_id") @db.VarChar(30)
  projectId         String?        @map("project_id") @db.VarChar(30)
  kind              String         @db.VarChar(50) // e.g. REVIEW_ENQUIRY, or CUSTOM for a staff-added task
  stage             String?        @db.VarChar(50) // workflow group key (project checklist): preshoot, shoot, ...
  type              String         @default("TODO") @db.VarChar(20) // TODO | AUTO_EMAIL | APPOINTMENT | SHOOT | AUTO
  title             String         @db.VarChar(150)
  status            WorkItemStatus @default(PENDING)
  order             Int            @default(0)
  dueAt             DateTime?      @map("due_at") @db.Timestamptz // optional per-task due date (editable)
  completedByUserId String?        @map("completed_by_user_id") @db.VarChar(30)
  completedAt       DateTime?      @map("completed_at") @db.Timestamptz
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  enquiry     Enquiry? @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  completedBy User?    @relation("WorkItemCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)

  @@index([enquiryId])
  @@index([projectId])
  @@map("work_items")
}

/// A calendar entry staff add directly, outside the workflow: an appointment, an extra shoot, or
/// another studio event. Workflow shoots come from Booking and workflow appointments from WorkItem;
/// this model covers everything staff want on the calendar without opening a case (BR-CAL).
model CalendarEvent {
  id              String    @id @default(cuid()) @db.VarChar(30)
  companyId       String    @map("company_id") @db.VarChar(30)
  kind            String    @default("APPOINTMENT") @db.VarChar(20) // APPOINTMENT | SHOOT | OTHER
  title           String    @db.VarChar(200)
  startsAt        DateTime  @map("starts_at") @db.Timestamptz
  endsAt          DateTime? @map("ends_at") @db.Timestamptz
  allDay          Boolean   @default(false) @map("all_day")
  location        String?   @db.VarChar(255)
  notes           String?   @db.Text
  clientId        String?   @map("client_id") @db.VarChar(30)
  createdByUserId String?   @map("created_by_user_id") @db.VarChar(30)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client    Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdBy User?   @relation("CalendarEventCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([startsAt])
  @@map("calendar_events")
}

// Files on a project. v1 stores an external URL; real object storage is an env-flag later. Clients
// only ever see CLIENT_VISIBLE files.
model File {
  id               String         @id @default(cuid()) @db.VarChar(30)
  projectId        String         @map("project_id") @db.VarChar(30)
  kind             FileKind
  visibility       FileVisibility @default(INTERNAL)
  name             String         @db.VarChar(255)
  url              String         @db.VarChar(2048)
  sizeBytes        Int?           @map("size_bytes")
  uploadedByUserId String?        @map("uploaded_by_user_id") @db.VarChar(30)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User?   @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([projectId, visibility])
  @@map("files")
}

// A questionnaire sent to the client to collect event details. The question set is Company config
// (OQ-016, TBD); this stores whatever questions/answers are used.
model Questionnaire {
  id          String              @id @default(cuid()) @db.VarChar(30)
  projectId   String              @map("project_id") @db.VarChar(30)
  status      QuestionnaireStatus @default(PENDING)
  accessToken String?             @unique @map("access_token") @db.VarChar(64) // client fill link
  title       String?             @db.VarChar(150)
  sentAt      DateTime?           @map("sent_at") @db.Timestamptz
  completedAt DateTime?           @map("completed_at") @db.Timestamptz
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  project Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  answers QuestionnaireAnswer[]

  @@index([projectId])
  @@map("questionnaires")
}

model QuestionnaireAnswer {
  id              String   @id @default(cuid()) @db.VarChar(30)
  questionnaireId String   @map("questionnaire_id") @db.VarChar(30)
  question        String   @db.VarChar(500)
  answer          String   @db.Text
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  questionnaire Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)

  @@index([questionnaireId])
  @@map("questionnaire_answers")
}

// Refund against a captured payment. Total refunds never exceed the captured amount (domain check);
// the money movement is also written as a REFUND PaymentTransaction (append-only).
model Refund {
  id                String            @id @default(cuid()) @db.VarChar(30)
  paymentId         String            @map("payment_id") @db.VarChar(30)
  amount            Decimal           @db.Decimal(12, 2)
  currency          String            @default("AUD") @db.VarChar(3)
  reason            String?           @db.VarChar(500)
  status            TransactionStatus @default(PENDING)
  externalReference String?           @map("external_reference") @db.VarChar(100)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz
  processedAt       DateTime?         @map("processed_at") @db.Timestamptz

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@map("refunds")
}

// A post-confirmation change request, routed by type. Never edits records in place: a commercial
// change spawns a new quote version, operational a new booking, data an audited client edit.
model ChangeRequest {
  id                      String              @id @default(cuid()) @db.VarChar(30)
  projectId               String              @map("project_id") @db.VarChar(30)
  type                    ChangeRequestType
  status                  ChangeRequestStatus @default(PENDING)
  requestedByType         String              @map("requested_by_type") @db.VarChar(10) // staff | client
  requestedByUserId       String?             @map("requested_by_user_id") @db.VarChar(30)
  description             String              @db.Text
  reason                  String?             @db.VarChar(500)
  commercialImpact        Decimal?            @map("commercial_impact") @db.Decimal(12, 2)
  scheduleImpact          Boolean             @default(false) @map("schedule_impact")
  resultingQuoteVersionId String?             @map("resulting_quote_version_id") @db.VarChar(30)
  approvedByUserId        String?             @map("approved_by_user_id") @db.VarChar(30)
  approvedAt              DateTime?           @map("approved_at") @db.Timestamptz
  rejectedAt              DateTime?           @map("rejected_at") @db.Timestamptz
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  project               Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedBy           User?         @relation("ChangeRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  approvedBy            User?         @relation("ChangeApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  resultingQuoteVersion QuoteVersion? @relation(fields: [resultingQuoteVersionId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([status])
  @@map("change_requests")
}
