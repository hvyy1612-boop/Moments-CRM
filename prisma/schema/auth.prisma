enum UserRole {
  ADMIN
  STUDIO
  SUPERVISOR
}

enum SecurityOutcome {
  SUCCESS
  FAILURE
}

model User {
  id                        String    @id @default(cuid()) @db.VarChar(30)
  companyId                 String    @map("company_id") @db.VarChar(30)
  email                     String    @unique @db.Citext
  passwordHash              String    @map("password_hash") @db.VarChar(255)
  passwordAlgo              String    @map("password_algo") @db.VarChar(30)
  role                      UserRole
  name                      String    @db.VarChar(150)
  isActive                  Boolean   @default(true) @map("is_active")
  status                    String    @default("ACTIVE") @db.VarChar(20)
  mustChangePassword        Boolean   @default(false) @map("must_change_password")
  lastLoginAt               DateTime? @map("last_login_at") @db.Timestamptz
  notificationsSeenAt       DateTime? @map("notifications_seen_at") @db.Timestamptz
  failedAttempts            Int       @default(0) @map("failed_attempts")
  lockedUntil               DateTime? @map("locked_until") @db.Timestamptz
  activityPinHash           String?   @map("activity_pin_hash") @db.VarChar(255)
  activityPinAlgo           String?   @map("activity_pin_algo") @db.VarChar(30)
  activityPinFailedAttempts Int       @default(0) @map("activity_pin_failed_attempts")
  activityPinLockedUntil    DateTime? @map("activity_pin_locked_until") @db.Timestamptz
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company                 Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  passwordResets          PasswordReset[]
  sessions                Session[]
  signInLogs              SignInLog[]
  recoveryCodes           RecoveryCode[]
  auditLogs               AuditLog[]
  ownedProjects           Project[]         @relation("ProjectOwner")
  createdQuoteVersions    QuoteVersion[]    @relation("QuoteVersionCreatedBy")
  createdContractVersions ContractVersion[] @relation("ContractVersionCreatedBy")
  recordedPayments        Payment[]         @relation("PaymentRecordedBy")
  ownedEnquiries          Enquiry[]         @relation("EnquiryOwner")
  communications          Communication[]   @relation("CommunicationBy")
  editedCommunications    Communication[]   @relation("CommunicationEditedBy")
  requestedChanges        ChangeRequest[]   @relation("ChangeRequestedBy")
  approvedChanges         ChangeRequest[]   @relation("ChangeApprovedBy")
  completedWorkItems      WorkItem[]        @relation("WorkItemCompletedBy")
  createdCalendarEvents   CalendarEvent[]   @relation("CalendarEventCreatedBy")

  @@index([companyId])
  @@index([role])
  @@map("users")
}

model PasswordReset {
  id          String    @id @default(cuid()) @db.VarChar(30)
  userId      String    @map("user_id") @db.VarChar(30)
  tokenHash   String    @map("token_hash") @db.VarChar(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  usedAt      DateTime? @map("used_at") @db.Timestamptz
  requestedIp String    @map("requested_ip") @db.VarChar(45)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_resets")
}

model RecoveryCode {
  id        String   @id @default(cuid()) @db.VarChar(30)
  userId    String   @map("user_id") @db.VarChar(30)
  codeHash  String   @map("code_hash") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

model Session {
  id                String    @id @default(cuid()) @db.VarChar(30)
  userId            String    @map("user_id") @db.VarChar(30)
  tokenHash         String    @map("token_hash") @db.VarChar(64)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz
  lastActiveAt      DateTime  @default(now()) @map("last_active_at") @db.Timestamptz
  userAgent         String?   @map("user_agent") @db.VarChar(400)
  ipAddress         String?   @map("ip_address") @db.VarChar(45)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("sessions")
}

model SignInLog {
  id             String          @id @default(cuid()) @db.VarChar(30)
  eventType      String          @map("event_type") @db.VarChar(100)
  userId         String?         @map("user_id") @db.VarChar(30)
  emailAttempted String?         @map("email_attempted") @db.Citext
  ipAddress      String          @map("ip_address") @db.VarChar(45)
  userAgent      String?         @map("user_agent") @db.VarChar(400)
  outcome        SecurityOutcome
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
  @@map("security_events")
}

model AuditLog {
  id          String   @id @default(cuid()) @db.VarChar(30)
  companyId   String?  @map("company_id") @db.VarChar(30)
  actorUserId String?  @map("actor_user_id") @db.VarChar(30)
  action      String   @db.VarChar(100)
  entityType  String   @map("entity_type") @db.VarChar(50)
  entityId    String   @map("entity_id") @db.VarChar(30)
  beforeData  Json?    @map("before_data")
  afterData   Json?    @map("after_data")
  reason      String?  @db.VarChar(500)
  source      String?  @db.VarChar(50)
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
