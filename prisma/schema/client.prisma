enum ClientType {
  INDIVIDUAL
  BUSINESS
}

enum ClientStatus {
  PROSPECT
  ACTIVE
  ARCHIVED
}

enum ClientSource {
  ENQUIRY
  REFERRAL
  MANUAL
  OTHER
}

model Client {
  id               String       @id @default(cuid()) @db.VarChar(30)
  companyId        String       @map("company_id") @db.VarChar(30)
  clientNumber     String?      @map("client_number") @db.VarChar(20)
  type             ClientType   @default(INDIVIDUAL)
  status           ClientStatus @default(PROSPECT)
  source           ClientSource @default(MANUAL)
  displayName      String       @map("display_name") @db.VarChar(150)
  legalName        String?      @map("legal_name") @db.VarChar(150)
  firstName        String?      @map("first_name") @db.VarChar(80)
  lastName         String?      @map("last_name") @db.VarChar(80)
  email            String       @unique @db.Citext
  phone            String?      @db.VarChar(30)
  street           String?      @db.VarChar(200)
  suburb           String?      @db.VarChar(100)
  state            String?      @db.VarChar(100)
  postcode         String?      @db.VarChar(20)
  country          String?      @db.VarChar(100)
  partnerName      String?      @map("partner_name") @db.VarChar(150)
  preferredContact String?      @map("preferred_contact") @db.VarChar(120)
  instagram        String?      @db.VarChar(100)
  notes            String?      @db.Text
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt       DateTime?    @map("archived_at") @db.Timestamptz

  company                Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  projects               Project[]
  convertedFromEnquiries Enquiry[]       @relation("EnquiryConvertedClient")
  enquiries              Enquiry[]       @relation("ClientEnquiries")
  communications         Communication[]
  calendarEvents         CalendarEvent[]

  @@unique([companyId, clientNumber])
  @@index([companyId])
  @@index([status])
  @@map("clients")
}
