enum InvoiceType {
  DEPOSIT
  BALANCE
  SUPPLEMENTARY
}

enum InvoiceStatus {
  ISSUED
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum PaymentStatus {
  PAID
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD
  CASH
  OTHER
}

enum TransactionType {
  CHARGE
  REFUND
}

model Invoice {
  id                     String        @id @default(cuid()) @db.VarChar(30)
  projectId              String        @map("project_id") @db.VarChar(30)
  invoiceNumber          String        @unique @map("invoice_number") @db.VarChar(30)
  type                   InvoiceType
  status                 InvoiceStatus @default(ISSUED)
  currency               String        @default("AUD") @db.VarChar(3)
  subtotal               Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal               Decimal       @default(0) @map("tax_total") @db.Decimal(12, 2)
  total                  Decimal       @default(0) @db.Decimal(12, 2)
  amountPaid             Decimal       @default(0) @map("amount_paid") @db.Decimal(12, 2)
  dueAt                  DateTime?     @map("due_at") @db.Timestamptz
  issuedAt               DateTime?     @map("issued_at") @db.Timestamptz
  billingNameSnapshot    String        @map("billing_name_snapshot") @db.VarChar(150)
  billingEmailSnapshot   String?       @map("billing_email_snapshot") @db.VarChar(255)
  billingPhoneSnapshot   String?       @map("billing_phone_snapshot") @db.VarChar(40)
  billingJobNameSnapshot String?       @map("billing_job_name_snapshot") @db.VarChar(150)
  invoiceDate            DateTime?     @map("invoice_date") @db.Timestamptz
  poNumber               String?       @map("po_number") @db.VarChar(60)
  notes                  String?       @db.Text
  accessToken            String?       @unique @map("access_token") @db.VarChar(64)
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  lines       InvoiceLine[]
  payments    Payment[]
  instalments InvoiceInstalment[]
  creditNotes CreditNote[]

  @@index([projectId])
  @@index([status])
  @@index([dueAt])
  @@map("invoices")
}

model CreditNote {
  id             String   @id @default(cuid()) @db.VarChar(30)
  invoiceId      String   @map("invoice_id") @db.VarChar(30)
  amount         Decimal  @db.Decimal(12, 2)
  reason         String?  @db.VarChar(500)
  issuedByUserId String?  @map("issued_by_user_id") @db.VarChar(30)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("credit_notes")
}

model InvoiceInstalment {
  id        String    @id @default(cuid()) @db.VarChar(30)
  invoiceId String    @map("invoice_id") @db.VarChar(30)
  label     String?   @db.VarChar(100)
  dueAt     DateTime? @map("due_at") @db.Timestamptz
  amount    Decimal   @default(0) @db.Decimal(12, 2)
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_instalments")
}

model InvoiceLine {
  id          String   @id @default(cuid()) @db.VarChar(30)
  invoiceId   String   @map("invoice_id") @db.VarChar(30)
  itemName    String?  @map("item_name") @db.VarChar(200)
  description String   @db.VarChar(500)
  quantity    Int      @default(1)
  unitPrice   Decimal  @default(0) @map("unit_price") @db.Decimal(12, 2)
  discount    Decimal  @default(0) @db.Decimal(12, 2)
  tax         Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal   Decimal  @default(0) @map("line_total") @db.Decimal(12, 2)
  sortOrder   Int      @default(0) @map("sort_order")
  source      String?  @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_lines")
}

model Payment {
  id               String        @id @default(cuid()) @db.VarChar(30)
  invoiceId        String        @map("invoice_id") @db.VarChar(30)
  projectId        String        @map("project_id") @db.VarChar(30)
  status           PaymentStatus @default(PAID)
  amount           Decimal       @db.Decimal(12, 2)
  currency         String        @default("AUD") @db.VarChar(3)
  paymentMethod    PaymentMethod @map("payment_method")
  receivedAt       DateTime?     @map("received_at") @db.Timestamptz
  recordedByUserId String?       @map("recorded_by_user_id") @db.VarChar(30)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  invoice      Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  project      Project              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  recordedBy   User?                @relation("PaymentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  transactions PaymentTransaction[]
  refunds      Refund[]

  @@index([invoiceId])
  @@index([projectId])
  @@map("payments")
}

model PaymentTransaction {
  id                    String          @id @default(cuid()) @db.VarChar(30)
  paymentId             String          @map("payment_id") @db.VarChar(30)
  provider              String          @default("manual") @db.VarChar(30)
  externalTransactionId String?         @map("external_transaction_id") @db.VarChar(100)
  type                  TransactionType
  amount                Decimal         @db.Decimal(12, 2)
  currency              String          @default("AUD") @db.VarChar(3)
  metadata              Json?
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@map("payment_transactions")
}

model Refund {
  id                String   @id @default(cuid()) @db.VarChar(30)
  paymentId         String   @map("payment_id") @db.VarChar(30)
  amount            Decimal  @db.Decimal(12, 2)
  currency          String   @default("AUD") @db.VarChar(3)
  reason            String?  @db.VarChar(500)
  externalReference String?  @map("external_reference") @db.VarChar(100)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@map("refunds")
}
