#Database
# Local development (Homebrew postgresql@16)
DATABASE_URL="postgresql://USERNAME@localhost:5432/moments_cms?schema=public"
# Prisma migrations 
DIRECT_URL="postgresql://USERNAME@localhost:5432/moments_cms?schema=public"
#App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secrets
# SESSION_SECRET=""   # REQUIRED in production: 32+ byte random secret for session + CSRF signing
# CRON_SECRET=""      # bearer token Vercel Cron sends to /api/cron/daily (reminders run only when set)

# Email
# With no provider nothing is sent: each send is recorded as "no provider", never faked as delivered.
# Option A: Gmail/SMTP 
# SMTP_USER="studio@gmail.com"
# SMTP_PASS=""            # Gmail App password (2FA on)
# SMTP_HOST="smtp.gmail.com"   # optional, default smtp.gmail.com
# SMTP_PORT="465"              # optional, default 465
# Option B: Resend (HTTP API): needs a verified sender.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Moments <hello@yourdomain.com>"   
# RESEND_WEBHOOK_SECRET="whsec_..."             # verifies /api/webhooks/resend delivery events
