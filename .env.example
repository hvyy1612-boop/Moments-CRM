# Copy to .env and fill in. Never commit .env (it is gitignored).
# env.ts validates the required variables at startup and refuses to boot if any are missing (SEC-A08).

# ---- Database ----
# Local development (Homebrew postgresql@16). The default superuser is your macOS username.
DATABASE_URL="postgresql://USERNAME@localhost:5432/moments_cms?schema=public"
# Prisma migrations use a direct (unpooled) connection. Locally this is the same as DATABASE_URL.
DIRECT_URL="postgresql://USERNAME@localhost:5432/moments_cms?schema=public"
#
# Production (Neon, see DECISIONS.md D-003):
#   DATABASE_URL -> the POOLED connection string (…-pooler.neon.tech, sslmode=require) used by the app
#   DIRECT_URL   -> the DIRECT connection string used only for migrations

# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Secrets (introduced in later slices; not required to boot Phase 0) ----
# SESSION_SECRET=""   # 32+ byte random secret for session + CSRF signing (Slice 2)
# CRON_SECRET=""      # bearer token Vercel Cron sends to protected cron routes (Slice 6, D-004)

# ---- Email (optional) ----
# The app works fully with no mail server: the ConsoleAdapter is the default (D4).
# Set SMTP_URL only to enable the SmtpAdapter behind its environment flag.
# SMTP_URL=""
