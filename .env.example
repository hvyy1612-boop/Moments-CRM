# Copy to .env and fill in. Never commit .env (it is gitignored).
# env.ts validates the required variables at startup and refuses to boot if any are missing (SEC-A08).

# ---- Database ----
# Local development (Homebrew postgresql@16). The default superuser is your macOS username.
DATABASE_URL="postgresql://USERNAME@localhost:5432/moments_cms?schema=public"
# Prisma migrations use a direct (unpooled) connection. Locally this is the same as DATABASE_URL.
DIRECT_URL="postgresql://USERNAME@localhost:5432/moments_cms?schema=public"
#
# Production (Neon, see DECISIONS.md D-003):
#   DATABASE_URL -> the POOLED connection string (…-pooler.neon.tech, sslmode=require) used by the app
#   DIRECT_URL   -> the DIRECT connection string used only for migrations

# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Secrets ----
# SESSION_SECRET=""   # REQUIRED in production: 32+ byte random secret for session + CSRF signing
# CRON_SECRET=""      # bearer token Vercel Cron sends to /api/cron/daily (reminders run only when set)

# ---- Email (optional; pick one) ----
# With no provider nothing is sent: each send is recorded as "no provider", never faked as delivered.
# Option A - Gmail/SMTP (takes precedence): send from the studio's own mailbox with an App password.
# SMTP_USER="studio@gmail.com"
# SMTP_PASS=""            # Gmail App password (2FA on)
# SMTP_HOST="smtp.gmail.com"   # optional, default smtp.gmail.com
# SMTP_PORT="465"              # optional, default 465
# Option B - Resend (HTTP API): needs a verified sender.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Moments <hello@yourdomain.com>"   # also the "from" for SMTP when set
# RESEND_WEBHOOK_SECRET="whsec_..."             # verifies /api/webhooks/resend delivery events
